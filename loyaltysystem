<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#6d5dfc">
<title>Nova Rewards</title>
<style>
:root{
  --primary:#6d5dfc; --primary-dark:#5547df; --primary-soft:#eeecff;
  --secondary:#00b8a9; --secondary-soft:#ddfaf7;
  --accent:#ffb703; --accent-soft:#fff5d5;
  --danger:#e5484d; --danger-soft:#fff0f0;
  --success:#16a66a; --success-soft:#e8fff4;
  --info:#1686d9; --info-soft:#eaf6ff;
  --bg:#f6f7ff; --surface:#fff; --surface-soft:#fafaff;
  --text:#1d2340; --text-soft:#5f6685; --text-muted:#8f95ad;
  --border:#e7e9f3;
  --shadow:0 20px 60px rgba(77,67,156,.12);
  --shadow-soft:0 10px 30px rgba(50,45,100,.08);
  --pill:999px;
  --safe:env(safe-area-inset-bottom,0px);
  --nav-h:76px;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0;min-height:100vh;color:var(--text);
  background:
    radial-gradient(circle at 0% 0%,rgba(109,93,252,.18),transparent 32%),
    radial-gradient(circle at 100% 8%,rgba(0,184,169,.14),transparent 26%),
    linear-gradient(180deg,#fbfbff,var(--bg));
  font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;
}
button,input,select{font:inherit}
button{-webkit-tap-highlight-color:transparent;cursor:pointer}
.hidden{display:none !important}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}

.shell{position:relative;width:min(100%,520px);min-height:100vh;margin:0 auto}
.hdr{
  position:sticky;top:0;z-index:30;height:72px;display:flex;align-items:center;
  justify-content:space-between;gap:14px;padding:12px 18px;
  background:rgba(250,250,255,.9);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
  border-bottom:1px solid rgba(231,233,243,.85);
}
.lock{display:flex;align-items:center;gap:11px;min-width:0}
.logo{
  position:relative;flex:0 0 auto;width:44px;height:44px;display:grid;place-items:center;
  border-radius:15px;color:#fff;font-weight:900;font-size:18px;
  background:linear-gradient(135deg,var(--primary),#9a6cff);
  box-shadow:0 10px 24px rgba(109,93,252,.26);
}
.logo::after{content:"";position:absolute;right:-2px;top:-2px;width:12px;height:12px;border-radius:50%;background:var(--secondary);border:3px solid #fff}
.bname{margin:0;font-size:17px;font-weight:800;letter-spacing:-.025em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bcap{margin:3px 0 0;color:var(--text-muted);font-size:10px;font-weight:700;letter-spacing:.09em;text-transform:uppercase}
.iconbtn{
  width:44px;height:44px;flex:0 0 auto;display:grid;place-items:center;border:1px solid var(--border);
  border-radius:15px;background:#fff;color:var(--text);box-shadow:var(--shadow-soft);transition:transform .16s,border-color .16s
}
.iconbtn:hover{transform:translateY(-2px);border-color:rgba(109,93,252,.35)}
.iconbtn svg{width:20px;height:20px}
main{padding:22px 18px calc(var(--nav-h) + 96px + var(--safe))}

.page{display:none;animation:pe .32s cubic-bezier(.2,.8,.2,1)}
.page.active{display:block}
@keyframes pe{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01ms !important;transition-duration:.01ms !important}}

.eyebrow{margin:0 0 6px;color:var(--primary);font-size:11px;font-weight:850;letter-spacing:.1em;text-transform:uppercase}
.title{margin:0;font-size:clamp(26px,7.6vw,33px);line-height:1.1;font-weight:900;letter-spacing:-.045em}
.sub{margin:9px 0 0;color:var(--text-soft);font-size:14px;line-height:1.6}
.sec{margin-top:26px}
.sech{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:13px}
.sect{margin:0;font-size:18px;font-weight:850;letter-spacing:-.03em}
.seclink{border:0;padding:4px;background:none;color:var(--primary);font-size:13px;font-weight:800}
.card{background:rgba(255,255,255,.95);border:1px solid rgba(231,233,243,.95);border-radius:26px;box-shadow:var(--shadow-soft)}

.btn{min-height:54px;border-radius:17px;padding:0 20px;border:0;font-weight:850;display:inline-flex;align-items:center;justify-content:center;gap:10px;transition:transform .16s,opacity .16s}
.btn:hover{transform:translateY(-2px)}
.btn:disabled{opacity:.55;cursor:not-allowed;transform:none}
.btn-p{color:#fff;background:linear-gradient(135deg,var(--primary),#8b62ff);box-shadow:0 14px 30px rgba(109,93,252,.25)}
.btn-g{color:var(--text);background:#fff;border:1px solid var(--border)}
.w100{width:100%}

.wrow{display:flex;align-items:center;justify-content:space-between;gap:16px}
.ava{width:52px;height:52px;flex:0 0 auto;display:grid;place-items:center;border-radius:18px;color:var(--primary);background:var(--primary-soft);font-size:17px;font-weight:900}

.mcard{
  position:relative;overflow:hidden;margin-top:20px;min-height:232px;padding:24px;color:#fff;border-radius:29px;
  background:linear-gradient(135deg,#674cf4 0%,#8f66ff 48%,#00b8a9 140%);
  box-shadow:0 26px 58px rgba(81,65,195,.3)
}
.mcard::before{content:"";position:absolute;width:215px;height:215px;top:-122px;right:-72px;border-radius:50%;background:rgba(255,255,255,.14)}
.mcard::after{content:"";position:absolute;width:148px;height:148px;bottom:-103px;left:34px;border-radius:50%;background:rgba(255,255,255,.09)}
.mtop,.mbot{position:relative;z-index:2}
.mtop{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}
.tbadge{padding:9px 13px;border-radius:var(--pill);background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.24);font-size:11px;font-weight:850;letter-spacing:.07em;text-transform:uppercase}
.mnum{font-size:12px;font-weight:700;opacity:.8}
.blabel{position:relative;z-index:2;margin-top:34px;font-size:13px;font-weight:650;opacity:.85}
.bval{position:relative;z-index:2;display:flex;align-items:baseline;gap:8px;margin-top:4px}
.bval strong{font-size:44px;line-height:1;font-weight:900;letter-spacing:-.06em}
.bval span{font-size:15px;font-weight:750;opacity:.86}
.mbot{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin-top:32px}
.mname{margin:0;font-size:15px;font-weight:850}
.msince{margin:4px 0 0;font-size:11px;opacity:.72}
.mmark{display:grid;place-items:center;width:38px;height:38px;border-radius:13px;background:rgba(255,255,255,.15);font-weight:900}

.tier{padding:20px}
.tiertop{display:flex;align-items:center;justify-content:space-between;gap:14px}
.tiert{margin:0;font-size:15px;font-weight:850}
.tierc{margin:5px 0 0;color:var(--text-soft);font-size:12px}
.tieric{width:43px;height:43px;display:grid;place-items:center;border-radius:15px;background:var(--accent-soft);color:#9b6900;font-size:19px}
.track{height:11px;margin-top:17px;border-radius:var(--pill);background:#edf0f7;overflow:hidden}
.fill{height:100%;width:0;border-radius:inherit;background:linear-gradient(90deg,var(--primary),var(--secondary));transition:width .8s cubic-bezier(.2,.8,.2,1)}
.tlabels{display:flex;justify-content:space-between;gap:16px;margin-top:9px;color:var(--text-muted);font-size:11px;font-weight:700}

.qgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.qa{min-width:0;border:1px solid var(--border);border-radius:19px;padding:14px 6px 12px;background:#fff;color:var(--text);box-shadow:var(--shadow-soft);transition:transform .16s,border-color .16s}
.qa:hover{transform:translateY(-3px);border-color:rgba(109,93,252,.35)}
.qic{width:40px;height:40px;margin:0 auto 8px;display:grid;place-items:center;border-radius:14px;color:var(--primary);background:var(--primary-soft)}
.qa:nth-child(2) .qic{color:#03857b;background:var(--secondary-soft)}
.qa:nth-child(3) .qic{color:#b27100;background:var(--accent-soft)}
.qa:nth-child(4) .qic{color:var(--info);background:var(--info-soft)}
.qa svg{width:20px;height:20px}
.qa span{display:block;font-size:11px;font-weight:800;overflow:hidden;text-overflow:ellipsis}

.promo{position:relative;overflow:hidden;padding:22px;background:linear-gradient(135deg,#fff3cb,#fff9e8);border:1px solid #ffe29c}
.promo::after{content:"";position:absolute;width:120px;height:120px;right:-35px;top:-45px;border-radius:50%;background:rgba(255,183,3,.17)}
.ptag{display:inline-flex;padding:6px 10px;border-radius:var(--pill);color:#8c6000;background:rgba(255,183,3,.2);font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
.ptitle{position:relative;z-index:2;width:76%;margin:14px 0 0;font-size:20px;line-height:1.22;font-weight:900;letter-spacing:-.035em}
.pcopy{position:relative;z-index:2;width:78%;margin:8px 0 0;color:#7a6637;font-size:13px;line-height:1.5}

.chips{display:flex;gap:9px;margin:20px -18px 0;padding:0 18px 4px;overflow-x:auto;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chip{flex:0 0 auto;border:1px solid var(--border);border-radius:var(--pill);padding:10px 15px;background:#fff;color:var(--text-soft);font-size:12px;font-weight:800}
.chip.active{color:#fff;background:var(--primary);border-color:var(--primary);box-shadow:0 9px 20px rgba(109,93,252,.22)}
.rgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px;margin-top:18px}
.rcard{overflow:hidden;text-align:left;padding:0;border:1px solid rgba(231,233,243,.95);background:#fff;border-radius:26px;box-shadow:var(--shadow-soft);transition:transform .18s,box-shadow .18s}
.rcard:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
.rimg{height:122px;display:grid;place-items:center;font-size:44px;background:linear-gradient(135deg,var(--primary-soft),var(--secondary-soft))}
.rcard:nth-child(2n) .rimg{background:linear-gradient(135deg,var(--accent-soft),#fff0e4)}
.rcard:nth-child(3n) .rimg{background:linear-gradient(135deg,var(--secondary-soft),#e6f8ff)}
.rbody{padding:15px}
.rcat{color:var(--text-muted);font-size:10px;font-weight:850;letter-spacing:.08em;text-transform:uppercase}
.rname{min-height:38px;margin:7px 0 12px;font-size:14px;line-height:1.35;font-weight:850}
.rprice{display:flex;align-items:center;gap:6px;color:var(--primary);font-size:13px;font-weight:900}
.rlock{color:var(--text-muted)}

.vcard{position:relative;overflow:hidden;padding:21px;margin-top:14px}
.vcard::before,.vcard::after{content:"";position:absolute;top:50%;width:24px;height:24px;border-radius:50%;background:var(--bg);transform:translateY(-50%)}
.vcard::before{left:-13px}
.vcard::after{right:-13px}
.vtop{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}
.vic{width:54px;height:54px;flex:0 0 auto;display:grid;place-items:center;border-radius:18px;background:var(--primary-soft);color:var(--primary);font-size:24px}
.vstat{padding:7px 10px;border-radius:var(--pill);color:var(--success);background:var(--success-soft);font-size:10px;font-weight:900;text-transform:uppercase}
.vtitle{margin:17px 0 0;font-size:18px;font-weight:900;letter-spacing:-.03em}
.vdesc{margin:7px 0 0;color:var(--text-soft);font-size:13px;line-height:1.5}
.vfoot{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:17px;padding-top:16px;border-top:1px dashed #d9dce8}
.vexp{color:var(--text-muted);font-size:11px;font-weight:700}
.vact{border:0;background:none;color:var(--primary);font-size:12px;font-weight:900}

.empty{padding:36px 24px;text-align:center;margin-top:18px}
.eic{width:70px;height:70px;margin:0 auto;display:grid;place-items:center;border-radius:23px;background:var(--primary-soft);color:var(--primary);font-size:28px}
.etitle{margin:17px 0 0;font-size:18px;font-weight:900}
.ecopy{margin:8px auto 0;max-width:280px;color:var(--text-soft);font-size:13px;line-height:1.55}

.alist{margin-top:18px;padding:0 18px}
.aitem{display:grid;grid-template-columns:48px 1fr auto;align-items:center;gap:13px;padding:16px 0;border-bottom:1px solid var(--border)}
.aitem:last-child{border-bottom:0}
.aic{width:48px;height:48px;display:grid;place-items:center;border-radius:16px;background:var(--success-soft);color:var(--success);font-size:18px;font-weight:900}
.aic.redeemed{background:var(--danger-soft);color:var(--danger)}
.aic.bonus{background:var(--accent-soft);color:#a76e00}
.at{margin:0;font-size:14px;font-weight:850}
.am{margin:5px 0 0;color:var(--text-muted);font-size:11px;line-height:1.45}
.ap{text-align:right;color:var(--success);font-size:14px;font-weight:900}
.ap.neg{color:var(--danger)}

.phero{padding:25px;text-align:center}
.pava{width:84px;height:84px;margin:0 auto;display:grid;place-items:center;border-radius:28px;color:#fff;font-size:26px;font-weight:900;background:linear-gradient(135deg,var(--primary),var(--secondary));box-shadow:0 16px 32px rgba(109,93,252,.22)}
.pname{margin:16px 0 0;font-size:22px;font-weight:900}
.pphone{margin:6px 0 0;color:var(--text-soft);font-size:13px}
.ptier{display:inline-flex;margin-top:12px;padding:8px 13px;border-radius:var(--pill);color:var(--primary);background:var(--primary-soft);font-size:11px;font-weight:900;text-transform:uppercase}
.srow{width:100%;min-height:62px;display:flex;align-items:center;gap:13px;padding:13px 17px;border:0;border-bottom:1px solid var(--border);background:#fff;color:var(--text);text-align:left}
.srow:last-child{border-bottom:0}
.sic{width:38px;height:38px;flex:0 0 auto;display:grid;place-items:center;border-radius:13px;color:var(--primary);background:var(--primary-soft);font-size:16px}
.scopy{flex:1;min-width:0}
.st{display:block;font-size:13px;font-weight:850}
.sc{display:block;margin-top:3px;color:var(--text-muted);font-size:10px}
.sarr{color:var(--text-muted);font-size:18px}
.settings{overflow:hidden}

nav.bn{
  position:fixed;z-index:40;left:50%;bottom:0;width:min(100%,520px);
  display:grid;grid-template-columns:repeat(5,1fr);gap:4px;
  padding:9px 9px calc(9px + var(--safe));transform:translateX(-50%);
  background:rgba(255,255,255,.95);border-top:1px solid rgba(231,233,243,.95);
  backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  box-shadow:0 -14px 34px rgba(44,39,87,.08)
}
.nb{min-width:0;border:0;border-radius:16px;padding:7px 2px 5px;color:var(--text-muted);background:none}
.nb.active{color:var(--primary);background:var(--primary-soft)}
.nb svg{width:21px;height:21px}
.nic{display:grid;place-items:center;height:26px}
.nl{display:block;margin-top:3px;font-size:9px;font-weight:850;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

.fab{position:fixed;z-index:45;left:50%;bottom:calc(var(--nav-h) + 14px + var(--safe));width:min(calc(100% - 36px),484px);transform:translateX(-50%)}
.fabbtn{width:100%;min-height:56px;border:0;border-radius:19px;color:#fff;font-weight:900;background:linear-gradient(135deg,var(--secondary),#08c7b6);box-shadow:0 17px 34px rgba(0,184,169,.26)}
body:not(.fab-on) .fab{display:none}

.mb{position:fixed;z-index:100;inset:0;display:none;align-items:flex-end;justify-content:center;padding:16px;background:rgba(23,26,48,.5);backdrop-filter:blur(8px)}
.mb.open{display:flex}
.mp{width:min(100%,500px);max-height:92vh;overflow-y:auto;border-radius:29px;background:#fff;box-shadow:0 30px 90px rgba(20,22,42,.3);animation:me .26s ease-out}
@keyframes me{from{opacity:0;transform:translateY(28px) scale(.98)}to{opacity:1;transform:none}}
.mh{position:sticky;top:0;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:18px 20px;background:rgba(255,255,255,.97);border-bottom:1px solid var(--border)}
.mt{margin:0;font-size:18px;font-weight:900}
.mx{width:40px;height:40px;display:grid;place-items:center;border:0;border-radius:14px;background:var(--surface-soft);color:var(--text);font-size:20px}
.mc{padding:22px}

.ill{width:82px;height:82px;margin:0 auto 18px;display:grid;place-items:center;border-radius:28px;color:var(--primary);background:linear-gradient(135deg,var(--primary-soft),var(--secondary-soft));font-size:33px}
.ch{margin:0;text-align:center;font-size:24px;font-weight:900;letter-spacing:-.04em}
.cc{margin:9px auto 0;max-width:350px;text-align:center;color:var(--text-soft);font-size:13px;line-height:1.55}
.rprev{margin-top:20px;padding:18px;border-radius:22px;background:var(--surface-soft);border:1px solid var(--border)}
.rrow{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-top:12px;color:var(--text-soft);font-size:12px}
.rrow:first-child{margin-top:0}
.rrow strong{color:var(--text);text-align:right}
.cpts{margin-top:17px;padding:16px;border-radius:18px;color:var(--primary-dark);background:var(--primary-soft);text-align:center}
.cpts span{display:block;font-size:11px;font-weight:800;text-transform:uppercase}
.cpts strong{display:block;margin-top:4px;font-size:24px;font-weight:900}

.field{margin-top:18px}
.flabel{display:block;margin-bottom:8px;font-size:12px;font-weight:850}
.pfield{display:grid;grid-template-columns:78px 1fr;gap:9px}
.cc2,.inp{width:100%;min-height:54px;border:1px solid var(--border);border-radius:16px;background:#fff;color:var(--text);outline:none}
.cc2{display:grid;place-items:center;background:var(--surface-soft);font-size:13px;font-weight:850}
.inp{padding:0 15px}
.inp:focus{border-color:var(--primary);box-shadow:0 0 0 4px var(--primary-soft)}
.ferr{min-height:17px;margin:6px 0 0;color:var(--danger);font-size:11px;font-weight:700}
.note{margin:13px 0 0;color:var(--text-muted);font-size:10px;line-height:1.5;text-align:center}

.sv{padding:10px 0 2px;text-align:center}
.schk{width:90px;height:90px;margin:0 auto;display:grid;place-items:center;border-radius:30px;color:#fff;font-size:36px;background:linear-gradient(135deg,var(--success),var(--secondary));box-shadow:0 18px 40px rgba(22,166,106,.24)}
.stitle{margin:22px 0 0;font-size:26px;font-weight:900;letter-spacing:-.045em}
.ssub{margin:9px auto 0;max-width:330px;color:var(--text-soft);font-size:13px;line-height:1.55}
.spts{margin:22px 0;padding:22px;border-radius:22px;background:linear-gradient(135deg,var(--primary-soft),var(--secondary-soft))}
.spts span{display:block;color:var(--text-soft);font-size:11px;font-weight:850;text-transform:uppercase}
.spts strong{display:block;margin-top:5px;color:var(--primary);font-size:38px;font-weight:900;letter-spacing:-.05em}

.toasts{position:fixed;z-index:200;top:16px;left:50%;width:min(calc(100% - 28px),470px);transform:translateX(-50%);pointer-events:none}
.toast{display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:18px;background:rgba(255,255,255,.98);border:1px solid var(--border);box-shadow:var(--shadow);font-size:13px;animation:te .26s ease-out}
.toast.error{border-color:rgba(229,72,77,.3)}
.toast.success{border-color:rgba(22,166,106,.28)}
.tdot{width:26px;height:26px;flex:0 0 auto;display:grid;place-items:center;border-radius:9px;background:var(--success-soft);color:var(--success);font-weight:900}
.toast.error .tdot{background:var(--danger-soft);color:var(--danger)}
@keyframes te{from{opacity:0;transform:translateY(-12px)}to{opacity:1;transform:none}}
.spin{width:19px;height:19px;border:3px solid rgba(255,255,255,.45);border-top-color:#fff;border-radius:50%;animation:sp .65s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}

@media (min-width:760px){
  body{padding:22px 0}
  .shell{min-height:calc(100vh - 44px);border-radius:32px;border:1px solid rgba(231,233,243,.95);overflow:hidden;background:rgba(255,255,255,.4)}
  nav.bn{bottom:22px;border-radius:0 0 32px 32px}
  .fab{bottom:calc(var(--nav-h) + 36px + var(--safe))}
}
@media (max-width:370px){
  main{padding-left:14px;padding-right:14px}
  .rgrid{grid-template-columns:1fr}
}
</style>
</head>
<body class="fab-on">

<div class="shell">
  <header class="hdr">
    <div class="lock">
      <div class="logo" id="brandLogo">N</div>
      <div style="min-width:0">
        <h1 class="bname" id="brandName">Nova Rewards</h1>
        <p class="bcap">Loyalty made delightful</p>
      </div>
    </div>
    <button class="iconbtn" type="button" data-action="notify" aria-label="Notifications">
