<script>
(function () {
  "use strict";

  /* ============================================================
     1) CONFIGURATION — white-label per merchant
     ============================================================ */
  var APP_CONFIG = {
    merchant: {
      tenantId: "TENANT-NOVA-001",
      brandName: "Nova Rewards",
      brandInitial: "N",
      currencySymbol: "RM",
      referralCode: "ALYSSA2026",
      theme: {
        primary: "#6d5dfc",
        primaryDark: "#5547df",
        secondary: "#00b8a9",
        accent: "#ffb703",
        background: "#f6f7ff"
      }
    },
    /* Never commit a live Power Automate URL to a public repo.
       Put a secured gateway/proxy URL here when the backend is ready. */
    api: {
      claimReceipt: "PASTE_SECURE_CLAIM_ENDPOINT_HERE",
      redeemReward: "PASTE_SECURE_REDEEM_ENDPOINT_HERE"
    },
    demoMode: true,
    pointsPerCurrency: 1
  };

  /* ============================================================
     2) STATE
     ============================================================ */
  var state = {
    page: "home",
    filter: "all",
    member: {
      firstName: "Alyssa",
      lastName: "Tan",
      phone: "+60 12-345 6789",
      tier: "Gold",
      nextTier: "Platinum",
      points: 2480,
      tierFloor: 1500,
      tierTarget: 3000,
      memberSince: 2026
    },
    receipt: {
      receiptId: "NV-20260928-8451",
      outletId: "OUTLET-CENTRAL-01",
      outletName: "Central Mall",
      amount: 128.40,
      transactionDate: "28 Sep 2026",
      points: 128,
      signature: "DEMO-SIGNATURE"
    },
    rewards: [
      { id:"RWD-001", name:"Signature beverage", category:"food", categoryLabel:"Dining", points:550, emoji:"\u2615", description:"Enjoy one handcrafted signature beverage at participating outlets." },
      { id:"RWD-002", name:"RM20 dining voucher", category:"voucher", categoryLabel:"Voucher", points:900, emoji:"\uD83C\uDF9F\uFE0F", description:"Receive RM20 off your next eligible dining transaction." },
      { id:"RWD-003", name:"Premium dessert", category:"food", categoryLabel:"Dining", points:750, emoji:"\uD83C\uDF70", description:"Choose one premium dessert from the participating menu." },
      { id:"RWD-004", name:"Members-only experience", category:"experience", categoryLabel:"Experience", points:2200, emoji:"\u2728", description:"Unlock a curated members-only experience for one person." }
    ],
    vouchers: [
      { id:"VCH-1001", title:"RM10 Welcome Voucher", description:"RM10 off with a minimum eligible spend of RM50.", expiry:"31 Oct 2026", status:"Available" },
      { id:"VCH-1002", title:"Complimentary Beverage", description:"One complimentary beverage at participating outlets.", expiry:"15 Nov 2026", status:"Available" }
    ],
    activities: [
      { type:"earned",   title:"Receipt claimed",  meta:"Central Mall \u2022 26 Sep 2026",   points:120 },
      { type:"bonus",    title:"Campaign bonus",   meta:"Weekend bonus \u2022 21 Sep 2026",  points:80 },
      { type:"redeemed", title:"Reward redeemed",  meta:"Signature beverage \u2022 18 Sep 2026", points:-550 },
      { type:"earned",   title:"Receipt claimed",  meta:"Riverside Outlet \u2022 11 Sep 2026", points:245 },
      { type:"earned",   title:"Referral completed", meta:"Referral reward \u2022 3 Sep 2026", points:200 }
    ]
  };

  /* ============================================================
     3) UTILITIES
     ============================================================ */
  function $(id) { return document.getElementById(id); }

  function setText(id, value) {
    var el = $(id);
    if (el) { el.textContent = value; }
  }

  function esc(value) {
    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function num(value) {
    var n = Number(value);
    if (!isFinite(n)) { return "0"; }
    return n.toLocaleString("en-US");
  }

  function money(value) {
    var n = Number(value);
    if (!isFinite(n)) { return "\u2014"; }
    return APP_CONFIG.merchant.currencySymbol + " " + n.toFixed(2);
  }

  function digits(value) { return String(value).replace(/\D/g, ""); }

  function validPhone(value) {
    var d = digits(value);
    if (d.indexOf("60") === 0) { return /^601\d{8,9}$/.test(d); }
    if (d.charAt(0) === "0")   { return /^01\d{8,9}$/.test(d); }
    return /^1\d{8,9}$/.test(d);
  }

  function normalizePhone(value) {
    var d = digits(value);
    if (d.indexOf("60") === 0) { return "+" + d; }
    if (d.charAt(0) === "0") { d = d.slice(1); }
    return "+60" + d;
  }

  function wait(ms) {
    return new Promise(function (resolve) { setTimeout(resolve, ms); });
  }

  /* ============================================================
     4) BRANDING
     ============================================================ */
  function applyBranding() {
    var m = APP_CONFIG.merchant;
    var root = document.documentElement;
    root.style.setProperty("--primary", m.theme.primary);
    root.style.setProperty("--primary-dark", m.theme.primaryDark);
    root.style.setProperty("--secondary", m.theme.secondary);
    root.style.setProperty("--accent", m.theme.accent);
    root.style.setProperty("--bg", m.theme.background);
    document.title = m.brandName;
    setText("brandName", m.brandName);
    setText("brandLogo", m.brandInitial);
    setText("cardMark", m.brandInitial);
  }

  /* ============================================================
     5) MEMBER RENDERING
     ============================================================ */
  function renderMember() {
    var m = state.member;
    var full = m.firstName + " " + m.lastName;
    var initials = (m.firstName.charAt(0) + m.lastName.charAt(0)).toUpperCase();

    setText("welcomeName", m.firstName);
    setText("homeAvatar", initials);
    setText("profileAvatar", initials);
    setText("cardName", full);
    setText("profileName", full);
    setText("profilePhone", m.phone);
    setText("cardSince", "Member since " + m.memberSince);
    setText("tierBadge", m.tier + " Member");
    setText("profileTier", m.tier + " Member");
    setText("pointsBalance", num(m.points));
    setText("tierFloorLabel", m.tier + ": " + num(m.tierFloor));
    setText("tierTargetLabel", m.nextTier + ": " + num(m.tierTarget));

    var remaining = Math.max(0, m.tierTarget - m.points);
    setText("tierCaption", remaining === 0
      ? "You have reached " + m.nextTier
      : num(remaining) + " more points to unlock " + m.nextTier);

    var span = m.tierTarget - m.tierFloor;
    var pct = span > 0 ? ((m.points - m.tierFloor) / span) * 100 : 100;
    pct = Math.min(100, Math.max(0, Math.round(pct)));

    var fill = $("tierFill");
    if (fill) { fill.style.width = pct + "%"; }
    var bar = $("tierBar");
    if (bar) { bar.setAttribute("aria-valuenow", String(pct)); }
  }

  /* ============================================================
     6) RECEIPT PREVIEW
     ============================================================ */
  function renderReceipt() {
    var r = state.receipt;
    setText("rcpId", r.receiptId);
    setText("rcpOutlet", r.outletName);
    setText("rcpAmount", money(r.amount));
    setText("rcpDate", r.transactionDate);
    setText("rcpPoints", num(r.points) + " points");
    setClaimLoading(false);
  }

  /* ============================================================
     7) LISTS
     ============================================================ */
  function activityRow(a) {
    var negative = Number(a.points) < 0;
    var cls = a.type === "redeemed" ? "redeemed" : (a.type === "bonus" ? "bonus" : "");
    var icon = a.type === "redeemed" ? "\u2193" : (a.type === "bonus" ? "\u2726" : "\u2191");
    return '<div class="aitem">' +
             '<div class="aic ' + cls + '">' + icon + '</div>' +
             '<div><p class="at">' + esc(a.title) + '</p><p class="am">' + esc(a.meta) + '</p></div>' +
             '<div class="ap ' + (negative ? "neg" : "") + '">' +
               (negative ? "" : "+") + num(a.points) +
             '</div>' +
           '</div>';
  }

  function renderActivity() {
    var full = $("fullActivity");
    var recent = $("recentActivity");
    var rows = state.activities.map(activityRow);
    if (full) { full.innerHTML = rows.join(""); }
    if (recent) { recent.innerHTML = rows.slice(0, 3).join(""); }
  }

  function renderRewards() {
    var grid = $("rewardGrid");
    if (!grid) { return; }

    var list = state.filter === "all"
      ? state.rewards
      : state.rewards.filter(function (r) { return r.category === state.filter; });

    if (!list.length) {
      grid.innerHTML = '<div class="card empty" style="grid-column:1/-1">' +
        '<div class="eic">\u2726</div>' +
        '<h3 class="etitle">Nothing here yet</h3>' +
        '<p class="ecopy">There are no rewards in this category right now.</p></div>';
      return;
    }

    grid.innerHTML = list.map(function (r) {
      var can = state.member.points >= r.points;
      return '<button class="rcard" type="button" data-action="open-reward" data-id="' + esc(r.id) + '">' +
               '<span class="rimg">' + esc(r.emoji) + '</span>' +
               '<span class="rbody">' +
                 '<span class="rcat">' + esc(r.categoryLabel) + '</span>' +
                 '<span class="rname" style="display:block">' + esc(r.name) + '</span>' +
                 '<span class="rprice ' + (can ? "" : "rlock") + '">\u2726 ' + num(r.points) + ' points</span>' +
               '</span>' +
             '</button>';
    }).join("");
  }

  function renderWallet() {
    var list = $("walletList");
    if (!list) { return; }

    if (!state.vouchers.length) {
      list.innerHTML = '<div class="card empty">' +
        '<div class="eic">\uD83C\uDF9F\uFE0F</div>' +
        '<h3 class="etitle">Your wallet is ready</h3>' +
        '<p class="ecopy">Rewards and vouchers you redeem will appear here.</p></div>';
      return;
    }

    list.innerHTML = state.vouchers.map(function (v) {
      return '<article class="card vcard">' +
               '<div class="vtop"><div class="vic">\uD83C\uDF9F\uFE0F</div>' +
               '<span class="vstat">' + esc(v.status) + '</span></div>' +
               '<h3 class="vtitle">' + esc(v.title) + '</h3>' +
               '<p class="vdesc">' + esc(v.description) + '</p>' +
               '<div class="vfoot">' +
                 '<span class="vexp">Valid until ' + esc(v.expiry) + '</span>' +
                 '<button class="vact" type="button" data-action="open-voucher" data-id="' + esc(v.id) + '">View code</button>' +
               '</div>' +
             '</article>';
    }).join("");
  }

  /* ============================================================
     8) NAVIGATION
     ============================================================ */
  function navigate(page) {
    var target = $("page-" + page);
    if (!target) { return; }

    var pages = document.querySelectorAll(".page");
    for (var i = 0; i < pages.length; i++) { pages[i].classList.remove("active"); }
    target.classList.add("active");

    var buttons = document.querySelectorAll(".nb");
    for (var j = 0; j < buttons.length; j++) {
      buttons[j].classList.toggle("active", buttons[j].getAttribute("data-page") === page);
    }

    state.page = page;
    document.body.classList.toggle("fab-on", page === "home");
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  /* ============================================================
     9) MODALS
     ============================================================ */
  function openModal(id) {
    var el = $(id);
    if (!el) { return; }
    el.classList.add("open");
    document.body.style.overflow = "hidden";
  }

  function closeModal(id) {
    var el = $(id);
    if (!el) { return; }
    el.classList.remove("open");
    document.body.style.overflow = "";
  }

  function closeAllModals() {
    var open = document.querySelectorAll(".mb.open");
    for (var i = 0; i < open.length; i++) { open[i].classList.remove("open"); }
    document.body.style.overflow = "";
  }

  /* ============================================================
     10) TOASTS
     ============================================================ */
  var toastTimer = null;
  function toast(message, type) {
    var host = $("toasts");
    if (!host) { return; }
    var kind = type === "error" ? "error" : "success";
    host.innerHTML = '<div class="toast ' + kind + '">' +
      '<span class="tdot">' + (kind === "error" ? "!" : "\u2713") + '</span>' +
      '<span>' + esc(message) + '</span></div>';
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { host.innerHTML = ""; }, 3200);
  }

  /* ============================================================
     11) CLAIM FLOW
     ============================================================ */
  function setClaimLoading(loading) {
    var btn = $("claimBtn");
    if (!btn) { return; }
    btn.disabled = !!loading;
    btn.innerHTML = loading
      ? '<span class="spin"></span>Validating receipt'
      : "Claim " + num(state.receipt.points) + " points";
  }

  function openClaim() {
    var formView = $("claimFormView");
    var successView = $("claimSuccessView");
    if (formView) { formView.classList.remove("hidden"); }
    if (successView) { successView.classList.add("hidden"); }
    setText("phoneError", "");
    setClaimLoading(false);
    openModal("claimModal");
    setTimeout(function () {
      var input = $("phoneInput");
      if (input) { input.focus(); }
    }, 180);
  }

  async function postJson(url, payload) {
    if (!url || url.indexOf("PASTE_SECURE") === 0) {
      throw new Error("The secure API endpoint has not been configured yet.");
    }
    var res = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });
    var body = {};
    try { body = await res.json(); } catch (e) { body = {}; }
    if (!res.ok) {
      throw new Error(body.message || ("Request failed with HTTP " + res.status + "."));
    }
    return body;
  }

  async function submitClaim(event) {
    event.preventDefault();

    var input = $("phoneInput");
    var value = input ? input.value.trim() : "";

    if (!validPhone(value)) {
      setText("phoneError", "Enter a valid Malaysian mobile number.");
      if (input) { input.focus(); }
      return;
    }

    setText("phoneError", "");
    setClaimLoading(true);

    var payload = {
      tenantId: APP_CONFIG.merchant.tenantId,
      receiptId: state.receipt.receiptId,
      outletId: state.receipt.outletId,
      phone: normalizePhone(value),
      signature: state.receipt.signature,
      clientTimestamp: new Date().toISOString()
    };

    try {
      var result;

      if (APP_CONFIG.demoMode) {
        await wait(900);
        result = {
          status: "success",
          pointsEarned: state.receipt.points,
          updatedBalance: state.member.points + state.receipt.points
        };
      } else {
        result = await postJson(APP_CONFIG.api.claimReceipt, payload);
      }

      if (!result || result.status !== "success") {
        throw new Error((result && result.message) || "This receipt could not be claimed.");
      }

      state.member.points = Number(result.updatedBalance);
      state.activities.unshift({
        type: "earned",
        title: "Receipt claimed",
        meta: state.receipt.outletName + " \u2022 Today",
        points: Number(result.pointsEarned)
      });

      renderMember();
      renderActivity();
      renderRewards();

      setText("earnedPoints", "+" + num(result.pointsEarned));
      $("claimFormView").classList.add("hidden");
      $("claimSuccessView").classList.remove("hidden");

    } catch (error) {
      toast(error.message || "We could not process your claim.", "error");
    } finally {
      setClaimLoading(false);
    }
  }

  /* ============================================================
     12) REWARD DETAIL + REDEMPTION
     ============================================================ */
  function openReward(id) {
    var reward = null;
    for (var i = 0; i < state.rewards.length; i++) {
      if (state.rewards[i].id === id) { reward = state.rewards[i]; break; }
    }
    if (!reward) { return; }

    var can = state.member.points >= reward.points;
    var short = Math.max(0, reward.points - state.member.points);

    $("rewardModalBody").innerHTML =
      '<div class="ill">' + esc(reward.emoji) + '</div>' +
      '<h3 class="ch">' + esc(reward.name) + '</h3>' +
      '<p class="cc">' + esc(reward.description) + '</p>' +
      '<div class="cpts"><span>Redemption value</span><strong>' + num(reward.points) + ' points</strong></div>' +
      '<button class="btn btn-p w100" style="margin-top:18px" type="button" ' +
        (can ? 'data-action="redeem" data-id="' + esc(reward.id) + '"' : "disabled") + '>' +
        (can ? "Redeem this reward" : "Earn " + num(short) + " more points") +
      '</button>' +
      '<p class="note">In production, redemption must be validated by the server before a voucher is issued.</p>';

    openModal("rewardModal");
  }

  function redeem(id) {
    var reward = null;
    for (var i = 0; i < state.rewards.length; i++) {
      if (state.rewards[i].id === id) { reward = state.rewards[i]; break; }
    }
    if (!reward) { return; }

    if (state.member.points < reward.points) {
      toast("You do not have enough points.", "error");
      return;
    }

    state.member.points -= reward.points;

    state.vouchers.unshift({
      id: "VCH-" + Date.now(),
      title: reward.name,
      description: "Issued from your points redemption.",
      expiry: "30 Nov 2026",
      status: "Available"
    });

    state.activities.unshift({
      type: "redeemed",
      title: "Reward redeemed",
      meta: reward.name + " \u2022 Today",
      points: -reward.points
    });

    renderMember();
    renderWallet();
    renderActivity();
    renderRewards();
    closeModal("rewardModal");
    toast("Reward added to your wallet.", "success");
  }

  /* ============================================================
     13) REFERRAL
     ============================================================ */
  function referral() {
    var code = APP_CONFIG.merchant.referralCode;
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(code).then(function () {
        toast("Referral code " + code + " copied.", "success");
      }).catch(function () {
        toast("Your referral code is " + code + ".", "success");
      });
      return;
    }
    toast("Your referral code is " + code + ".", "success");
  }

  /* ============================================================
     14) QR URL PARAMETERS (untrusted — server must re-validate)
     ============================================================ */
  function readReceiptFromUrl() {
    var params = new URLSearchParams(window.location.search);
    var receiptId = params.get("receipt");
    if (!receiptId) { return false; }

    state.receipt.receiptId = receiptId.slice(0, 80);

    var outlet = params.get("outlet");
    if (outlet) { state.receipt.outletName = outlet.slice(0, 80); }

    var outletId = params.get("outletid");
    if (outletId) { state.receipt.outletId = outletId.slice(0, 80); }

    var amount = Number(params.get("amount"));
    if (isFinite(amount) && amount > 0) {
      state.receipt.amount = amount;
      state.receipt.points = Math.floor(amount * APP_CONFIG.pointsPerCurrency);
    }

    var date = params.get("date");
    if (date) { state.receipt.transactionDate = date.slice(0, 40); }

    var sig = params.get("sig");
    if (sig) { state.receipt.signature = sig.slice(0, 300); }

    return true;
  }

  /* ============================================================
     15) EVENT DELEGATION (CSP-safe, no inline handlers)
     ============================================================ */
  document.addEventListener("click", function (event) {
    // Modal backdrop click
    if (event.target.classList && event.target.classList.contains("mb")) {
      closeModal(event.target.id);
      return;
    }

    var trigger = event.target.closest("[data-action]");
    if (!trigger) { return; }

    var action = trigger.getAttribute("data-action");

    if (action === "nav") {
      navigate(trigger.getAttribute("data-page"));

    } else if (action === "open-claim") {
      openClaim();

    } else if (action === "close-modal") {
      closeModal(trigger.getAttribute("data-modal"));

    } else if (action === "finish-claim") {
      closeModal("claimModal");
      navigate("home");
      toast("Your points balance has been updated.", "success");

    } else if (action === "filter") {
      state.filter = trigger.getAttribute("data-filter");
      var chips = document.querySelectorAll(".chip");
      for (var i = 0; i < chips.length; i++) { chips[i].classList.remove("active"); }
      trigger.classList.add("active");
      renderRewards();

    } else if (action === "open-reward") {
      openReward(trigger.getAttribute("data-id"));

    } else if (action === "redeem") {
      redeem(trigger.getAttribute("data-id"));

    } else if (action === "open-voucher") {
      toast("Voucher " + trigger.getAttribute("data-id") + " is ready for validation at the counter.", "success");

    } else if (action === "refer") {
      referral();

    } else if (action === "notify") {
      toast("You have no new notifications.", "success");

    } else if (action === "soon") {
      toast(trigger.getAttribute("data-label") + " will connect to your profile API.", "success");
    }
  });

  document.addEventListener("keydown", function (event) {
    if (event.key === "Escape") { closeAllModals(); }
  });

  /* ============================================================
     16) BOOTSTRAP
     ============================================================ */
  function init() {
    applyBranding();

    var hasReceipt = readReceiptFromUrl();

    renderMember();
    renderReceipt();
    renderRewards();
    renderWallet();
    renderActivity();

    var form = $("claimForm");
    if (form) { form.addEventListener("submit", submitClaim); }

    var phone = $("phoneInput");
    if (phone) {
      phone.addEventListener("input", function (e) {
        e.target.value = digits(e.target.value).slice(0, 11);
        setText("phoneError", "");
      });
    }

    if (hasReceipt) { openClaim(); }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>
</body>
</html>
