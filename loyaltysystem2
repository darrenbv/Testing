    },
    rewards: [
      { id:"RWD-001", name:"Signature beverage",      category:"food",       categoryLabel:"Dining",     points:550,  emoji:"\u2615",               tone:"rc1", description:"Enjoy one handcrafted signature beverage at participating outlets." },
      { id:"RWD-002", name:"RM20 dining voucher",     category:"voucher",    categoryLabel:"Voucher",    points:900,  emoji:"\uD83C\uDF9F\uFE0F",   tone:"rc2", description:"Receive RM20 off your next eligible dining transaction." },
      { id:"RWD-003", name:"Premium dessert",         category:"food",       categoryLabel:"Dining",     points:750,  emoji:"\uD83C\uDF70",         tone:"rc3", description:"Choose one premium dessert from the participating menu." },
      { id:"RWD-004", name:"Members-only experience", category:"experience", categoryLabel:"Experience", points:2200, emoji:"\u2728",               tone:"rc4", description:"Unlock a curated members-only experience for one person." },
      { id:"RWD-005", name:"Chef's tasting for two",  category:"experience", categoryLabel:"Experience", points:4800, emoji:"\uD83C\uDF7D\uFE0F",   tone:"rc1", description:"An exclusive chef-curated tasting menu for two guests." },
      { id:"RWD-006", name:"RM50 dining voucher",     category:"voucher",    categoryLabel:"Voucher",    points:2000, emoji:"\uD83D\uDCB3",         tone:"rc3", description:"Receive RM50 off your next eligible dining transaction." }
    ],
    vouchers: [
      { id:"VCH-1001", title:"RM10 Welcome Voucher",   description:"RM10 off with a minimum eligible spend of RM50.", expiry:"31 Oct 2026", status:"Available", emoji:"\uD83C\uDF81" },
      { id:"VCH-1002", title:"Complimentary Beverage", description:"One complimentary beverage at participating outlets.", expiry:"15 Nov 2026", status:"Available", emoji:"\u2615" }
    ],
    activities: [
      { type:"earned",   title:"Receipt claimed",    meta:"Central Mall \u2022 26 Sep 2026",        points:120 },
      { type:"bonus",    title:"Double points bonus", meta:"Weekend campaign \u2022 21 Sep 2026",   points:80 },
      { type:"redeemed", title:"Reward redeemed",    meta:"Signature beverage \u2022 18 Sep 2026",  points:-550 },
      { type:"earned",   title:"Receipt claimed",    meta:"Riverside Outlet \u2022 11 Sep 2026",    points:245 },
      { type:"earned",   title:"Referral completed", meta:"Referral reward \u2022 3 Sep 2026",      points:200 }
    ]
  };

  var reduceMotion = !!(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);

  /* ============================================================
     3) UTILITIES
     ============================================================ */
  function $(id) { return document.getElementById(id); }
  function setText(id, v) { var el = $(id); if (el) { el.textContent = v; } }
  function esc(v) {
    return String(v).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;");
  }
  function num(v) { var n = Number(v); return isFinite(n) ? Math.round(n).toLocaleString("en-US") : "0"; }
  function money(v) { var n = Number(v); return isFinite(n) ? APP_CONFIG.merchant.currencySymbol + " " + n.toFixed(2) : "\u2014"; }
  function digits(v) { return String(v).replace(/\D/g, ""); }
  function validPhone(v) {
    var d = digits(v);
    if (d.indexOf("60") === 0) { return /^601\d{8,9}$/.test(d); }
    if (d.charAt(0) === "0")   { return /^01\d{8,9}$/.test(d); }
    return /^1\d{8,9}$/.test(d);
  }
  function normalizePhone(v) {
    var d = digits(v);
    if (d.indexOf("60") === 0) { return "+" + d; }
    if (d.charAt(0) === "0") { d = d.slice(1); }
    return "+60" + d;
  }
  function wait(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }
  function findById(list, id) { for (var i = 0; i < list.length; i++) { if (list[i].id === id) { return list[i]; } } return null; }

  /* Animated number counter */
  function countTo(id, from, to, duration) {
    var el = $(id);
    if (!el) { return; }
    if (reduceMotion || typeof requestAnimationFrame !== "function" || from === to) { el.textContent = num(to); return; }
    var start = null;
    function step(ts) {
      if (start === null) { start = ts; }
      var p = Math.min(1, (ts - start) / duration);
      var eased = 1 - Math.pow(1 - p, 3);
      el.textContent = num(from + (to - from) * eased);
      if (p < 1) { requestAnimationFrame(step); }
    }
    requestAnimationFrame(step);
  }

  /* ============================================================
     4) THEME
     ============================================================ */
  function applyTheme(theme) {
    document.documentElement.setAttribute("data-theme", theme);
    var meta = document.querySelector('meta[name="theme-color"]');
    if (meta) { meta.setAttribute("content", theme === "dark" ? "#07071a" : "#f5f6ff"); }
    try { localStorage.setItem("nova-theme", theme); } catch (e) {}
  }
  function initTheme() {
    var saved = null;
    try { saved = localStorage.getItem("nova-theme"); } catch (e) {}
    applyTheme(saved === "dark" ? "dark" : "light");
  }
  function toggleTheme() {
    var cur = document.documentElement.getAttribute("data-theme");
    applyTheme(cur === "dark" ? "light" : "dark");
  }

  /* ============================================================
     5) BRANDING + MEMBER
     ============================================================ */
  function applyBranding() {
    var m = APP_CONFIG.merchant;
    document.title = m.brandName;
    setText("brandName", m.brandName);
    setText("brandLogo", m.brandInitial);
    setText("cardMark", m.cardMark);
  }

  function renderMember() {
    var m = state.member;
    var full = m.firstName + " " + m.lastName;
    var initials = (m.firstName.charAt(0) + m.lastName.charAt(0)).toUpperCase();

    setText("welcomeName", m.firstName);
    setText("homeAvatar", initials);
    setText("profileAvatar", initials);
    setText("cardName", full);
    setText("profileName", full);
    setText("profilePhone", m.phone);
    setText("tierBadge", m.tier);
    setText("profileTier", m.tier + " Member");

    countTo("pointsBalance", state.shownPoints, m.points, 1100);
    state.shownPoints = m.points;

    var remaining = Math.max(0, m.tierTarget - m.points);
    setText("ringTitle", "To " + m.nextTier);
    setText("tierCaption", remaining === 0 ? "Unlocked \u2014 welcome to " + m.nextTier + "!" : num(remaining) + " pts left to level up");

    var span = m.tierTarget - m.tierFloor;
    var pct = span > 0 ? ((m.points - m.tierFloor) / span) * 100 : 100;
    pct = Math.min(100, Math.max(0, Math.round(pct)));
    setText("ringPct", pct + "%");

    var ring = $("ringVal");
    if (ring) {
      var c = 2 * Math.PI * 31;
      ring.setAttribute("stroke-dasharray", c.toFixed(1));
      ring.setAttribute("stroke-dashoffset", (c * (1 - pct / 100)).toFixed(1));
    }
  }

  function renderReceipt() {
    var r = state.receipt;
    setText("rcpId", r.receiptId);
    setText("rcpOutlet", r.outletName);
    setText("rcpAmount", money(r.amount));
    setText("rcpDate", r.transactionDate);
    setText("rcpPoints", "+" + num(r.points) + " pts");
    setClaimLoading(false);
  }

  /* ============================================================
     6) LISTS
     ============================================================ */
  function activityRow(a) {
    var neg = Number(a.points) < 0;
    var cls = a.type === "redeemed" ? "redeemed" : (a.type === "bonus" ? "bonus" : "");
    var icon = a.type === "redeemed" ? "\u2193" : (a.type === "bonus" ? "\u2726" : "\u2191");
    return '<div class="aitem"><div class="aic ' + cls + '">' + icon + '</div>' +
      '<div><p class="at">' + esc(a.title) + '</p><p class="am">' + esc(a.meta) + '</p></div>' +
      '<div class="ap ' + (neg ? "neg" : "") + '">' + (neg ? "" : "+") + num(a.points) + '</div></div>';
  }

  function renderActivity() {
    var rows = state.activities.map(activityRow);
    var full = $("fullActivity"), recent = $("recentActivity");
    if (full) { full.innerHTML = rows.join(""); }
    if (recent) { recent.innerHTML = rows.slice(0, 3).join(""); }
  }

  function renderRewards() {
    var grid = $("rewardGrid");
    if (!grid) { return; }
    var list = state.filter === "all" ? state.rewards : state.rewards.filter(function (r) { return r.category === state.filter; });

    if (!list.length) {
      grid.innerHTML = '<div class="glass empty" style="grid-column:1/-1"><div class="eic">\u2726</div>' +
        '<h3 class="etitle">Nothing here yet</h3><p class="ecopy">No rewards in this category right now.</p></div>';
      return;
    }

    grid.innerHTML = list.map(function (r) {
      var can = state.member.points >= r.points;
      var prog = Math.min(100, Math.round((state.member.points / r.points) * 100));
      return '<button class="rcard" type="button" data-action="open-reward" data-id="' + esc(r.id) + '">' +
        '<span class="rimg ' + esc(r.tone) + '">' + esc(r.emoji) + '</span>' +
        '<span class="rbody"><span class="rcat">' + esc(r.categoryLabel) + '</span>' +
        '<span class="rname">' + esc(r.name) + '</span>' +
        '<span class="rprice ' + (can ? "" : "lock") + '">' + (can ? "\u2726 " : "\uD83D\uDD12 ") + num(r.points) + ' pts</span>' +
        (can ? "" : '<span class="rbar"><i style="width:' + prog + '%"></i></span>') +
        '</span></button>';
    }).join("");
  }

  function renderWallet() {
    var list = $("walletList");
    if (!list) { return; }
    if (!state.vouchers.length) {
      list.innerHTML = '<div class="glass empty"><div class="eic">\uD83C\uDF9F\uFE0F</div><h3 class="etitle">Your wallet is ready</h3>' +
        '<p class="ecopy">Rewards you redeem will appear here.</p></div>';
      return;
    }
    list.innerHTML = state.vouchers.map(function (v) {
      return '<article class="glass vcard"><div class="vleft">' + esc(v.emoji || "\uD83C\uDF9F\uFE0F") + '</div>' +
        '<div class="vright"><span class="vstat">' + esc(v.status) + '</span>' +
        '<h3 class="vtitle">' + esc(v.title) + '</h3><p class="vdesc">' + esc(v.description) + '</p>' +
        '<div class="vfoot"><span class="vexp">Valid until ' + esc(v.expiry) + '</span>' +
        '<button class="vact" type="button" data-action="open-voucher" data-id="' + esc(v.id) + '">Use now \u2192</button></div></div></article>';
    }).join("");
  }

  /* ============================================================
     7) NAVIGATION
     ============================================================ */
  function navigate(page) {
    var target = $("page-" + page);
    if (!target) { return; }
    var pages = document.querySelectorAll(".page");
    for (var i = 0; i < pages.length; i++) { pages[i].classList.remove("active"); }
    target.classList.add("active");
    var btns = document.querySelectorAll(".nb");
    for (var j = 0; j < btns.length; j++) { btns[j].classList.toggle("active", btns[j].getAttribute("data-page") === page); }
    state.page = page;
    document.body.classList.toggle("fab-on", page === "home");
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  /* ============================================================
     8) SHEETS + TOASTS
     ============================================================ */
  function openModal(id) { var el = $(id); if (el) { el.classList.add("open"); document.body.style.overflow = "hidden"; } }
  function closeModal(id) { var el = $(id); if (el) { el.classList.remove("open"); document.body.style.overflow = ""; } }
  function closeAllModals() {
    var open = document.querySelectorAll(".mb.open");
    for (var i = 0; i < open.length; i++) { open[i].classList.remove("open"); }
    document.body.style.overflow = "";
  }

  var toastTimer = null;
  function toast(msg, type) {
    var host = $("toasts");
    if (!host) { return; }
    var kind = type === "error" ? "error" : "success";
    host.innerHTML = '<div class="toast ' + kind + '"><span class="tdot">' + (kind === "error" ? "!" : "\u2713") + '</span><span>' + esc(msg) + '</span></div>';
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { host.innerHTML = ""; }, 3200);
  }

  /* ============================================================
     9) CONFETTI
     ============================================================ */
  function confetti() {
    if (reduceMotion) { return; }
    var cv = $("confetti");
    if (!cv || !cv.getContext || typeof requestAnimationFrame !== "function") { return; }
    var ctx = cv.getContext("2d");
    if (!ctx) { return; }
    var W = cv.width = window.innerWidth, H = cv.height = window.innerHeight;
    var colors = ["#7c5cff", "#22d3ee", "#a3f25c", "#ffc53d", "#ff5fa2", "#4f8bff"];
    var parts = [];
    for (var i = 0; i < 150; i++) {
      parts.push({
        x: W / 2, y: H * 0.42,
        vx: (Math.random() - 0.5) * 15, vy: -Math.random() * 15 - 4,
        s: Math.random() * 7 + 4, r: Math.random() * 6.28, vr: (Math.random() - 0.5) * 0.3,
        c: colors[i % colors.length], life: 0
      });
    }
    var frames = 0;
    function tick() {
      ctx.clearRect(0, 0, W, H);
      frames++;
      for (var k = 0; k < parts.length; k++) {
        var p = parts[k];
        p.vy += 0.35; p.vx *= 0.99; p.x += p.vx; p.y += p.vy; p.r += p.vr;
        ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.r);
        ctx.globalAlpha = Math.max(0, 1 - frames / 150);
        ctx.fillStyle = p.c; ctx.fillRect(-p.s / 2, -p.s / 4, p.s, p.s / 2);
        ctx.restore();
      }
      if (frames < 150) { requestAnimationFrame(tick); } else { ctx.clearRect(0, 0, W, H); }
    }
    requestAnimationFrame(tick);
  }

  /* ============================================================
     10) 3D HOLO CARD TILT
     ============================================================ */
  function initTilt() {
    var card = $("holoCard");
    if (!card || reduceMotion) { return; }
    card.addEventListener("pointermove", function (e) {
      var r = card.getBoundingClientRect();
      var x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
      card.style.setProperty("--ry", ((x - 0.5) * 14).toFixed(2) + "deg");
      card.style.setProperty("--rx", ((0.5 - y) * 12).toFixed(2) + "deg");
      card.style.setProperty("--mx", (x * 100).toFixed(1) + "%");
      card.style.setProperty("--my", (y * 100).toFixed(1) + "%");
    });
    card.addEventListener("pointerleave", function () {
      card.style.setProperty("--rx", "0deg"); card.style.setProperty("--ry", "0deg");
      card.style.setProperty("--mx", "50%"); card.style.setProperty("--my", "50%");
    });
  }

  /* ============================================================
     11) CLAIM FLOW
     ============================================================ */
  function setClaimLoading(loading) {
    var btn = $("claimBtn");
    if (!btn) { return; }
    btn.disabled = !!loading;
    btn.innerHTML = loading ? '<span class="spin"></span>Verifying receipt\u2026' : "Claim " + num(state.receipt.points) + " points \u2192";
  }

  function openClaim() {
    $("claimFormView").classList.remove("hidden");
    $("claimSuccessView").classList.add("hidden");
    setText("phoneError", "");
    setClaimLoading(false);
    openModal("claimModal");
    setTimeout(function () { var i = $("phoneInput"); if (i) { i.focus(); } }, 250);
  }

  async function postJson(url, payload) {
    if (!url || url.indexOf("PASTE_SECURE") === 0) { throw new Error("The secure API endpoint has not been configured yet."); }
    var res = await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
    var body = {};
    try { body = await res.json(); } catch (e) { body = {}; }
    if (!res.ok) { throw new Error(body.message || ("Request failed with HTTP " + res.status + ".")); }
    return body;
  }

  async function submitClaim(event) {
    event.preventDefault();
    var input = $("phoneInput");
    var value = input ? input.value.trim() : "";

    if (!validPhone(value)) {
      setText("phoneError", "Enter a valid Malaysian mobile number.");
      if (input) { input.focus(); }
      return;
    }
    setText("phoneError", "");
    setClaimLoading(true);

    var payload = {
      tenantId: APP_CONFIG.merchant.tenantId,
      receiptId: state.receipt.receiptId,
      outletId: state.receipt.outletId,
      phone: normalizePhone(value),
      signature: state.receipt.signature,
      clientTimestamp: new Date().toISOString()
    };

    try {
      var result;
      if (APP_CONFIG.demoMode) {
        await wait(1200);
        result = { status: "success", pointsEarned: state.receipt.points, updatedBalance: state.member.points + state.receipt.points };
      } else {
        result = await postJson(APP_CONFIG.api.claimReceipt, payload);
      }
      if (!result || result.status !== "success") { throw new Error((result && result.message) || "This receipt could not be claimed."); }

      state.member.points = Number(result.updatedBalance);
      state.activities.unshift({ type: "earned", title: "Receipt claimed", meta: state.receipt.outletName + " \u2022 Today", points: Number(result.pointsEarned) });

      renderMember();
      renderActivity();
      renderRewards();

      $("claimFormView").classList.add("hidden");
      $("claimSuccessView").classList.remove("hidden");
      setText("earnedPoints", "+0");
      countTo("earnedPoints", 0, Number(result.pointsEarned), 900);
      var ep = $("earnedPoints");
      setTimeout(function () { if (ep) { ep.textContent = "+" + num(result.pointsEarned); } }, reduceMotion ? 0 : 950);
      confetti();
    } catch (err) {
      toast(err.message || "We could not process your claim.", "error");
    } finally {
      setClaimLoading(false);
    }
  }

  /* ============================================================
     12) REWARD DETAIL + REDEMPTION
     ============================================================ */
  function openReward(id) {
    var r = findById(state.rewards, id);
    if (!r) { return; }
    var can = state.member.points >= r.points;
    var short = Math.max(0, r.points - state.member.points);
    $("rewardModalBody").innerHTML =
      '<div class="ill ' + esc(r.tone) + '">' + esc(r.emoji) + '</div>' +
      '<h3 class="ch">' + esc(r.name) + '</h3>' +
      '<p class="cc">' + esc(r.description) + '</p>' +
      '<div class="cpts"><span>Redemption value</span><strong class="num">' + num(r.points) + ' pts</strong></div>' +
      '<button class="btn btn-p w100" style="margin-top:16px" type="button" ' +
        (can ? 'data-action="redeem" data-id="' + esc(r.id) + '"' : "disabled") + '>' +
        (can ? "Redeem now \u2192" : "Earn " + num(short) + " more points") + '</button>' +
      '<p class="note">In production, redemption must be validated by the server before a voucher is issued.</p>';
    openModal("rewardModal");
  }

  function redeem(id) {
    var r = findById(state.rewards, id);
    if (!r) { return; }
    if (state.member.points < r.points) { toast("You do not have enough points.", "error"); return; }

    state.member.points -= r.points;
    state.vouchers.unshift({ id: "VCH-" + Date.now(), title: r.name, description: "Issued from your points redemption.", expiry: "30 Nov 2026", status: "Available", emoji: r.emoji });
    state.activities.unshift({ type: "redeemed", title: "Reward redeemed", meta: r.name + " \u2022 Today", points: -r.points });

    renderMember(); renderWallet(); renderActivity(); renderRewards();
    closeModal("rewardModal");
    confetti();
    toast("Reward added to your wallet.", "success");
  }

  /* ============================================================
     13) REFERRAL
     ============================================================ */
  function referral() {
    var code = APP_CONFIG.merchant.referralCode;
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(code)
        .then(function () { toast("Referral code " + code + " copied.", "success"); })
        .catch(function () { toast("Your referral code is " + code + ".", "success"); });
      return;
    }
    toast("Your referral code is " + code + ".", "success");
  }

  /* ============================================================
     14) QR URL PARAMETERS (untrusted — backend must re-validate)
     ============================================================ */
  function readReceiptFromUrl() {
    var params = new URLSearchParams(window.location.search);
    var id = params.get("receipt");
    if (!id) { return false; }
    state.receipt.receiptId = id.slice(0, 80);
    var outlet = params.get("outlet");     if (outlet)   { state.receipt.outletName = outlet.slice(0, 80); }
    var outletId = params.get("outletid"); if (outletId) { state.receipt.outletId = outletId.slice(0, 80); }
    var amount = Number(params.get("amount"));
    if (isFinite(amount) && amount > 0) {
      state.receipt.amount = amount;
      state.receipt.points = Math.floor(amount * APP_CONFIG.pointsPerCurrency);
    }
    var date = params.get("date"); if (date) { state.receipt.transactionDate = date.slice(0, 40); }
    var sig = params.get("sig");   if (sig)  { state.receipt.signature = sig.slice(0, 300); }
    return true;
  }

  /* ============================================================
     15) EVENT DELEGATION
     ============================================================ */
  document.addEventListener("click", function (event) {
    if (event.target.classList && event.target.classList.contains("mb")) { closeModal(event.target.id); return; }
    var t = event.target.closest("[data-action]");
    if (!t) { return; }
    var a = t.getAttribute("data-action");

    if (a === "nav") { navigate(t.getAttribute("data-page")); }
    else if (a === "open-claim") { openClaim(); }
    else if (a === "close-modal") { closeModal(t.getAttribute("data-modal")); }
    else if (a === "finish-claim") { closeModal("claimModal"); navigate("home"); toast("Your points balance has been updated.", "success"); }
    else if (a === "filter") {
      state.filter = t.getAttribute("data-filter");
      var chips = document.querySelectorAll(".chip-b");
      for (var i = 0; i < chips.length; i++) { chips[i].classList.remove("active"); }
      t.classList.add("active");
      renderRewards();
    }
    else if (a === "open-reward") { openReward(t.getAttribute("data-id")); }
    else if (a === "redeem") { redeem(t.getAttribute("data-id")); }
    else if (a === "open-voucher") { toast("Show voucher " + t.getAttribute("data-id") + " to the cashier for validation.", "success"); }
    else if (a === "refer") { referral(); }
    else if (a === "notify") { toast("You're all caught up. No new notifications.", "success"); }
    else if (a === "theme") { toggleTheme(); }
    else if (a === "soon") { toast(t.getAttribute("data-label") + " will connect to your profile API.", "success"); }
  });

  document.addEventListener("keydown", function (e) { if (e.key === "Escape") { closeAllModals(); } });

  /* ============================================================
     16) BOOTSTRAP
     ============================================================ */
  function init() {
    initTheme();
    applyBranding();
    var hasReceipt = readReceiptFromUrl();
    renderMember();
    renderReceipt();
    renderRewards();
    renderWallet();
    renderActivity();
    initTilt();

    var form = $("claimForm");
    if (form) { form.addEventListener("submit", submitClaim); }
    var phone = $("phoneInput");
    if (phone) {
      phone.addEventListener("input", function (e) {
        e.target.value = digits(e.target.value).slice(0, 11);
        setText("phoneError", "");
      });
    }
    if (hasReceipt) { openClaim(); }
  }

  if (document.readyState === "loading") { document.addEventListener("DOMContentLoaded", init); } else { init(); }
})();
</script>
</body>
</html>
