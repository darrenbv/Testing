    pointsPerCurrency: 1
  };

  /* ============================================================
     2) STATE
     ============================================================ */
  var state = {
    page: "home",
    filter: "all",
    shownPoints: 0,
    member: {
      firstName: "Alyssa", lastName: "Tan", phone: "+60 12-345 6789",
      tier: "Gold", nextTier: "Platinum",
