<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#f5f6ff">
<title>Nova Rewards</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<style>
/* =========================================================
   DESIGN TOKENS — LIGHT (default) + MIDNIGHT
   ========================================================= */
:root{
  --violet:#7c5cff; --cyan:#22d3ee; --pink:#ff5fa2; --lime:#a3f25c; --amber:#ffc53d;
  --grad:linear-gradient(120deg,#7c5cff 0%,#4f8bff 45%,#22d3ee 100%);
  --grad-warm:linear-gradient(120deg,#ff5fa2 0%,#ff8a5b 55%,#ffc53d 100%);
  --grad-iris:conic-gradient(from var(--hue,0deg),#7c5cff,#22d3ee,#a3f25c,#ffc53d,#ff5fa2,#7c5cff);

  --bg:#f5f6ff; --bg2:#eef0ff;
  --glass:rgba(255,255,255,.62); --glass-strong:rgba(255,255,255,.82);
  --stroke:rgba(124,92,255,.14); --stroke-soft:rgba(20,20,60,.07);
  --text:#12132b; --text-soft:#555a7c; --muted:#9296b5;
  --ok:#10b981; --ok-soft:rgba(16,185,129,.12);
  --bad:#f43f5e; --bad-soft:rgba(244,63,94,.12);
  --warm-soft:rgba(255,197,61,.18);
  --shadow:0 24px 60px -18px rgba(76,60,190,.28);
  --shadow-soft:0 10px 30px -12px rgba(40,40,110,.18);
  --grid:rgba(124,92,255,.07);
  --nav-h:74px; --safe:env(safe-area-inset-bottom,0px);
  --display:"Space Grotesk","Plus Jakarta Sans",system-ui,sans-serif;
}
[data-theme="dark"]{
  --bg:#07071a; --bg2:#0d0d28;
  --glass:rgba(22,22,52,.55); --glass-strong:rgba(26,26,60,.82);
  --stroke:rgba(140,120,255,.22); --stroke-soft:rgba(255,255,255,.07);
  --text:#f2f3ff; --text-soft:#b3b6d8; --muted:#7a7ea6;
  --shadow:0 24px 70px -18px rgba(0,0,0,.7);
  --shadow-soft:0 10px 30px -12px rgba(0,0,0,.6);
  --grid:rgba(140,120,255,.08);
}
@property --hue{syntax:"<angle>";inherits:true;initial-value:0deg}

*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0;min-height:100vh;color:var(--text);background:var(--bg);
  font-family:"Plus Jakarta Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;transition:background .5s,color .5s;
}
button,input{font:inherit;color:inherit}
button{cursor:pointer;-webkit-tap-highlight-color:transparent}
.hidden{display:none!important}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
.num{font-family:var(--display);font-variant-numeric:tabular-nums}

/* =========================================================
   AURORA BACKGROUND + GRID
   ========================================================= */
.aurora{position:fixed;inset:0;z-index:-2;overflow:hidden;pointer-events:none}
.blob{position:absolute;width:62vmax;height:62vmax;border-radius:50%;filter:blur(70px);opacity:.55;mix-blend-mode:multiply;animation:drift 22s ease-in-out infinite alternate}
[data-theme="dark"] .blob{mix-blend-mode:screen;opacity:.35}
.b1{background:#a58bff;top:-28vmax;left:-20vmax}
.b2{background:#6ee7f9;top:-18vmax;right:-26vmax;animation-delay:-6s}
.b3{background:#ffb1d0;bottom:-30vmax;left:-10vmax;animation-delay:-11s}
.b4{background:#d4ff9e;bottom:-34vmax;right:-22vmax;animation-delay:-3s;opacity:.35}
@keyframes drift{0%{transform:translate(0,0) scale(1)}50%{transform:translate(6vmax,4vmax) scale(1.08)}100%{transform:translate(-4vmax,7vmax) scale(.96)}}
.gridbg{position:fixed;inset:0;z-index:-1;pointer-events:none;
  background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);
  background-size:34px 34px;
  -webkit-mask-image:radial-gradient(ellipse at 50% 0%,#000 20%,transparent 70%);
  mask-image:radial-gradient(ellipse at 50% 0%,#000 20%,transparent 70%)}

/* =========================================================
   SHELL + HEADER
   ========================================================= */
.shell{position:relative;width:min(100%,520px);margin:0 auto;min-height:100vh}
.hdr{position:sticky;top:0;z-index:30;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 18px;
  background:linear-gradient(180deg,var(--bg) 40%,transparent);}
.lock{display:flex;align-items:center;gap:11px;min-width:0}
.logo{position:relative;width:44px;height:44px;border-radius:14px;display:grid;place-items:center;color:#fff;font-family:var(--display);font-weight:700;font-size:19px;background:var(--grad);box-shadow:0 10px 26px -6px rgba(124,92,255,.6)}
.logo::before{content:"";position:absolute;inset:-2px;border-radius:16px;background:var(--grad-iris);z-index:-1;filter:blur(8px);opacity:.7;animation:spinhue 6s linear infinite}
@keyframes spinhue{to{--hue:360deg}}
.bname{margin:0;font-family:var(--display);font-size:18px;font-weight:700;letter-spacing:-.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bcap{margin:2px 0 0;font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.hact{display:flex;gap:8px}
.ib{position:relative;width:42px;height:42px;display:grid;place-items:center;border-radius:14px;border:1px solid var(--stroke);background:var(--glass);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);box-shadow:var(--shadow-soft);transition:transform .2s}
.ib:hover{transform:translateY(-2px)}
.ib svg{width:19px;height:19px}
.dot{position:absolute;top:9px;right:10px;width:8px;height:8px;border-radius:50%;background:var(--pink);box-shadow:0 0 0 3px var(--bg)}

main{padding:6px 18px calc(var(--nav-h) + 110px + var(--safe))}

/* =========================================================
   PAGES
   ========================================================= */
.page{display:none}
.page.active{display:block;animation:rise .5s cubic-bezier(.2,.8,.2,1)}
@keyframes rise{from{opacity:0;transform:translateY(14px);filter:blur(4px)}to{opacity:1;transform:none;filter:none}}
.stag>*{opacity:0;animation:rise .6s cubic-bezier(.2,.8,.2,1) forwards}
.stag>*:nth-child(1){animation-delay:.02s}.stag>*:nth-child(2){animation-delay:.08s}.stag>*:nth-child(3){animation-delay:.14s}
.stag>*:nth-child(4){animation-delay:.2s}.stag>*:nth-child(5){animation-delay:.26s}.stag>*:nth-child(6){animation-delay:.32s}

.eyebrow{display:inline-flex;align-items:center;gap:7px;margin:0 0 8px;font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--violet)}
.eyebrow::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--grad);box-shadow:0 0 10px var(--cyan)}
.title{margin:0;font-family:var(--display);font-size:clamp(28px,8vw,36px);line-height:1.05;font-weight:700;letter-spacing:-.04em}
.gtext{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.sub{margin:8px 0 0;color:var(--text-soft);font-size:14px;line-height:1.6}
.sec{margin-top:24px}
.sech{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:12px}
.sect{margin:0;font-family:var(--display);font-size:18px;font-weight:700;letter-spacing:-.02em}
.link{border:0;background:none;padding:4px;font-size:13px;font-weight:800;color:var(--violet)}

.glass{background:var(--glass);border:1px solid var(--stroke);border-radius:26px;backdrop-filter:blur(22px) saturate(150%);-webkit-backdrop-filter:blur(22px) saturate(150%);box-shadow:var(--shadow-soft)}

.btn{position:relative;min-height:56px;padding:0 22px;border:0;border-radius:18px;font-weight:800;font-size:15px;display:inline-flex;align-items:center;justify-content:center;gap:10px;overflow:hidden;transition:transform .2s,opacity .2s}
.btn:hover{transform:translateY(-2px)}
.btn:disabled{opacity:.5;cursor:not-allowed;transform:none}
.btn-p{color:#fff;background:var(--grad);box-shadow:0 16px 34px -10px rgba(79,139,255,.7)}
.btn-p::after{content:"";position:absolute;top:0;left:-60%;width:40%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.45),transparent);transform:skewX(-20deg);animation:shine 3.2s ease-in-out infinite}
@keyframes shine{0%,60%{left:-60%}100%{left:130%}}
.w100{width:100%}

/* =========================================================
   GREETING
   ========================================================= */
.wrow{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:6px}
.ava{position:relative;width:54px;height:54px;flex:0 0 auto;border-radius:50%;display:grid;place-items:center;font-family:var(--display);font-weight:700;color:var(--text);background:var(--glass-strong)}
.ava::before{content:"";position:absolute;inset:-3px;border-radius:50%;background:var(--grad-iris);z-index:-1;animation:spinhue 5s linear infinite}

/* =========================================================
   HOLOGRAPHIC MEMBERSHIP CARD
   ========================================================= */
.cardwrap{perspective:1100px;margin-top:20px}
.holo{
  --rx:0deg;--ry:0deg;--mx:50%;--my:50%;
  position:relative;min-height:228px;padding:22px 22px 20px;border-radius:28px;color:#fff;overflow:hidden;isolation:isolate;
  background:
    radial-gradient(120% 90% at 0% 0%,#3b2bb8 0%,transparent 55%),
    radial-gradient(120% 90% at 100% 100%,#0e7490 0%,transparent 55%),
    linear-gradient(135deg,#120e3a,#0b0b24 60%,#081a2b);
  transform:rotateX(var(--rx)) rotateY(var(--ry));transform-style:preserve-3d;
  transition:transform .25s ease-out;
  box-shadow:0 34px 70px -24px rgba(60,40,200,.65),inset 0 0 0 1px rgba(255,255,255,.1)
}
.holo::before{ /* iridescent sheen follows pointer */
  content:"";position:absolute;inset:0;z-index:-1;opacity:.55;mix-blend-mode:color-dodge;
  background:radial-gradient(circle at var(--mx) var(--my),rgba(255,255,255,.55),transparent 38%),
             conic-gradient(from var(--hue,0deg) at var(--mx) var(--my),#7c5cff55,#22d3ee55,#a3f25c44,#ffc53d44,#ff5fa255,#7c5cff55);
  animation:spinhue 9s linear infinite}
.holo::after{ /* circuitry lines */
  content:"";position:absolute;inset:0;z-index:-1;opacity:.18;
  background-image:linear-gradient(rgba(255,255,255,.5) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.5) 1px,transparent 1px);
  background-size:22px 22px;
  -webkit-mask-image:linear-gradient(120deg,transparent 40%,#000 75%);mask-image:linear-gradient(120deg,transparent 40%,#000 75%)}
.htop{display:flex;justify-content:space-between;align-items:center}
.tier-pill{display:inline-flex;align-items:center;gap:7px;padding:7px 12px;border-radius:999px;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);backdrop-filter:blur(8px)}
.tier-pill i{width:8px;height:8px;border-radius:50%;background:var(--amber);box-shadow:0 0 12px var(--amber)}
.nfc{width:26px;height:26px;opacity:.85}
.chip{margin-top:20px;width:44px;height:33px;border-radius:8px;background:linear-gradient(135deg,#ffe29a,#c89b3c 55%,#ffe8b0);box-shadow:inset 0 0 0 1px rgba(0,0,0,.18);position:relative}
.chip::before,.chip::after{content:"";position:absolute;left:8px;right:8px;height:1px;background:rgba(0,0,0,.25)}
.chip::before{top:11px}.chip::after{bottom:11px}
.blabel{margin-top:16px;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;opacity:.7}
.bval{display:flex;align-items:baseline;gap:8px;margin-top:4px}
.bval strong{font-family:var(--display);font-size:48px;line-height:1;font-weight:700;letter-spacing:-.04em;text-shadow:0 0 30px rgba(34,211,238,.45)}
.bval span{font-size:14px;font-weight:700;opacity:.75}
.hbot{display:flex;justify-content:space-between;align-items:flex-end;margin-top:18px}
.hname{margin:0;font-weight:800;font-size:14px;letter-spacing:.06em;text-transform:uppercase}
.hno{margin:4px 0 0;font-family:var(--display);font-size:12px;letter-spacing:.2em;opacity:.65}
.hmark{font-family:var(--display);font-weight:700;font-size:15px;letter-spacing:.08em;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;filter:brightness(1.4)}

/* =========================================================
   STATS + TIER RING
   ========================================================= */
.stats{display:grid;grid-template-columns:1.25fr 1fr;gap:12px;margin-top:14px}
.ringcard{display:flex;align-items:center;gap:14px;padding:16px}
.ring{position:relative;width:74px;height:74px;flex:0 0 auto}
.ring svg{width:74px;height:74px;transform:rotate(-90deg)}
.ring .trk{stroke:var(--stroke-soft);stroke-width:8;fill:none}
.ring .val{stroke:url(#ringGrad);stroke-width:8;fill:none;stroke-linecap:round;transition:stroke-dashoffset 1.2s cubic-bezier(.2,.8,.2,1);filter:drop-shadow(0 0 6px rgba(34,211,238,.55))}
.ring b{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--display);font-size:16px;font-weight:700}
.rt{margin:0;font-size:13px;font-weight:800}
.rc{margin:4px 0 0;font-size:11.5px;line-height:1.45;color:var(--text-soft)}
.mini{padding:16px;display:flex;flex-direction:column;justify-content:space-between}
.mini small{font-size:10.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.mini strong{margin-top:6px;font-family:var(--display);font-size:26px;font-weight:700;letter-spacing:-.03em}
.mini em{font-style:normal;font-size:11px;font-weight:700;color:var(--ok)}

/* =========================================================
   QUICK ACTIONS
   ========================================================= */
.qgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.qa{min-width:0;padding:14px 4px 12px;border-radius:22px;border:1px solid var(--stroke);background:var(--glass);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);box-shadow:var(--shadow-soft);transition:transform .25s cubic-bezier(.2,.8,.2,1)}
.qa:hover{transform:translateY(-4px) scale(1.02)}
.qic{width:44px;height:44px;margin:0 auto 8px;border-radius:15px;display:grid;place-items:center;color:#fff;box-shadow:0 10px 20px -8px currentColor}
.qic svg{width:21px;height:21px}
.q1 .qic{background:linear-gradient(135deg,#7c5cff,#a78bfa);color:#fff}
.q2 .qic{background:linear-gradient(135deg,#06b6d4,#22d3ee)}
.q3 .qic{background:linear-gradient(135deg,#ff8a5b,#ffc53d)}
.q4 .qic{background:linear-gradient(135deg,#ff5fa2,#f472b6)}
.qa span{display:block;font-size:11px;font-weight:800}

/* =========================================================
   PROMO
   ========================================================= */
.promo{position:relative;overflow:hidden;padding:22px;border-radius:26px;color:#fff;background:var(--grad-warm);box-shadow:0 22px 44px -18px rgba(255,95,162,.7)}
.promo::before{content:"";position:absolute;width:190px;height:190px;right:-50px;top:-70px;border-radius:50%;background:rgba(255,255,255,.2)}
.promo::after{content:"2×";position:absolute;right:18px;bottom:6px;font-family:var(--display);font-size:78px;font-weight:700;opacity:.22;letter-spacing:-.05em}
.ptag{display:inline-flex;padding:6px 10px;border-radius:999px;background:rgba(255,255,255,.25);font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
.ptitle{position:relative;margin:12px 0 0;width:72%;font-family:var(--display);font-size:22px;line-height:1.15;font-weight:700;letter-spacing:-.03em}
.pcopy{position:relative;margin:7px 0 0;width:70%;font-size:13px;line-height:1.5;opacity:.92}

/* =========================================================
   REWARDS
   ========================================================= */
.chips{display:flex;gap:8px;margin:18px -18px 0;padding:0 18px 4px;overflow-x:auto;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chip-b{flex:0 0 auto;padding:10px 16px;border-radius:999px;border:1px solid var(--stroke);background:var(--glass);backdrop-filter:blur(14px);font-size:12.5px;font-weight:800;color:var(--text-soft)}
.chip-b.active{color:#fff;border-color:transparent;background:var(--grad);box-shadow:0 10px 22px -10px rgba(79,139,255,.9)}
.rgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:16px}
.rcard{position:relative;padding:0;text-align:left;border-radius:24px;border:1px solid var(--stroke);background:var(--glass);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);box-shadow:var(--shadow-soft);overflow:hidden;transition:transform .3s cubic-bezier(.2,.8,.2,1),box-shadow .3s}
.rcard:hover{transform:translateY(-5px);box-shadow:var(--shadow)}
.rimg{position:relative;height:118px;display:grid;place-items:center;font-size:48px}
.rimg::after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 120%,rgba(255,255,255,.55),transparent 60%)}
.rc1{background:linear-gradient(135deg,#c4b5fd,#a5f3fc)}
.rc2{background:linear-gradient(135deg,#fed7aa,#fbcfe8)}
.rc3{background:linear-gradient(135deg,#a7f3d0,#bae6fd)}
.rc4{background:linear-gradient(135deg,#fbcfe8,#c4b5fd)}
.rbody{display:block;padding:14px}
.rcat{display:block;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.rname{display:block;min-height:38px;margin:6px 0 10px;font-size:14px;line-height:1.35;font-weight:800}
.rprice{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;font-family:var(--display);font-size:12.5px;font-weight:700;color:#fff;background:var(--grad)}
.rprice.lock{background:var(--stroke-soft);color:var(--muted)}
.rbar{display:block;height:4px;margin-top:10px;border-radius:9px;background:var(--stroke-soft);overflow:hidden}
.rbar i{display:block;height:100%;background:var(--grad);border-radius:inherit}

/* =========================================================
   WALLET
   ========================================================= */
.vcard{position:relative;margin-top:14px;padding:0;overflow:hidden;display:grid;grid-template-columns:92px 1fr}
.vleft{display:grid;place-items:center;font-size:32px;background:var(--grad);color:#fff;position:relative}
.vleft::after{content:"";position:absolute;right:-1px;top:10px;bottom:10px;border-right:2px dashed rgba(255,255,255,.6)}
.vright{padding:16px 16px 14px}
.vstat{display:inline-flex;padding:5px 9px;border-radius:999px;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--ok);background:var(--ok-soft)}
.vtitle{margin:9px 0 0;font-family:var(--display);font-size:17px;font-weight:700;letter-spacing:-.02em}
.vdesc{margin:5px 0 0;font-size:12.5px;line-height:1.5;color:var(--text-soft)}
.vfoot{display:flex;justify-content:space-between;align-items:center;margin-top:12px}
.vexp{font-size:11px;font-weight:700;color:var(--muted)}
.vact{border:0;background:none;font-size:12px;font-weight:800;color:var(--violet)}

.empty{padding:36px 22px;text-align:center;margin-top:16px}
.eic{width:68px;height:68px;margin:0 auto;border-radius:22px;display:grid;place-items:center;font-size:28px;color:#fff;background:var(--grad)}
.etitle{margin:16px 0 0;font-family:var(--display);font-size:18px;font-weight:700}
.ecopy{margin:7px auto 0;max-width:270px;font-size:13px;line-height:1.55;color:var(--text-soft)}

/* =========================================================
   ACTIVITY
   ========================================================= */
.alist{padding:4px 16px}
.aitem{display:grid;grid-template-columns:44px 1fr auto;align-items:center;gap:12px;padding:14px 0;border-bottom:1px solid var(--stroke-soft)}
.aitem:last-child{border-bottom:0}
.aic{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;font-weight:800;color:var(--ok);background:var(--ok-soft)}
.aic.redeemed{color:var(--bad);background:var(--bad-soft)}
.aic.bonus{color:#c48600;background:var(--warm-soft)}
.at{margin:0;font-size:14px;font-weight:800}
.am{margin:4px 0 0;font-size:11px;color:var(--muted)}
.ap{font-family:var(--display);font-size:15px;font-weight:700;color:var(--ok)}
.ap.neg{color:var(--bad)}

/* =========================================================
   PROFILE
   ========================================================= */
.phero{padding:26px;text-align:center;position:relative;overflow:hidden}
.phero::before{content:"";position:absolute;inset:0 0 auto 0;height:90px;background:var(--grad);opacity:.16}
.pava{position:relative;width:86px;height:86px;margin:0 auto;border-radius:50%;display:grid;place-items:center;font-family:var(--display);font-size:28px;font-weight:700;color:#fff;background:var(--grad)}
.pava::before{content:"";position:absolute;inset:-4px;border-radius:50%;background:var(--grad-iris);z-index:-1;animation:spinhue 5s linear infinite}
.pname{margin:14px 0 0;font-family:var(--display);font-size:22px;font-weight:700}
.pphone{margin:5px 0 0;font-size:13px;color:var(--text-soft)}
.ptier{display:inline-flex;margin-top:12px;padding:7px 13px;border-radius:999px;font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:var(--grad)}
.settings{overflow:hidden}
.srow{width:100%;min-height:62px;display:flex;align-items:center;gap:13px;padding:12px 16px;border:0;border-bottom:1px solid var(--stroke-soft);background:transparent;text-align:left}
.srow:last-child{border-bottom:0}
.sic{width:38px;height:38px;flex:0 0 auto;border-radius:12px;display:grid;place-items:center;color:#fff;background:var(--grad);font-size:15px}
.scopy{flex:1;min-width:0}
.st{display:block;font-size:13.5px;font-weight:800}
.sc{display:block;margin-top:3px;font-size:11px;color:var(--muted)}
.sarr{color:var(--muted);font-size:18px}

/* =========================================================
   FLOATING DOCK NAV
   ========================================================= */
nav.dock{position:fixed;z-index:40;left:50%;bottom:calc(12px + var(--safe));transform:translateX(-50%);
  width:min(calc(100% - 24px),496px);height:var(--nav-h);display:grid;grid-template-columns:repeat(5,1fr);gap:4px;padding:8px;
  border-radius:26px;border:1px solid var(--stroke);background:var(--glass-strong);
  backdrop-filter:blur(26px) saturate(170%);-webkit-backdrop-filter:blur(26px) saturate(170%);box-shadow:var(--shadow)}
.nb{position:relative;min-width:0;border:0;border-radius:18px;background:transparent;color:var(--muted);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;transition:color .25s}
.nb svg{width:21px;height:21px;transition:transform .3s cubic-bezier(.2,.8,.2,1)}
.nb span{font-size:9.5px;font-weight:800;letter-spacing:.02em}
.nb.active{color:var(--violet)}
.nb.active svg{transform:translateY(-2px)}
.nb.active::before{content:"";position:absolute;inset:0;border-radius:18px;background:linear-gradient(135deg,rgba(124,92,255,.14),rgba(34,211,238,.14))}
.nb.active::after{content:"";position:absolute;bottom:4px;width:18px;height:3px;border-radius:3px;background:var(--grad);box-shadow:0 0 10px var(--cyan)}

.fab{position:fixed;z-index:41;left:50%;bottom:calc(var(--nav-h) + 24px + var(--safe));transform:translateX(-50%);width:min(calc(100% - 36px),484px)}
.fabbtn{position:relative;width:100%;min-height:58px;border:0;border-radius:20px;color:#fff;font-weight:800;font-size:15px;display:flex;align-items:center;justify-content:center;gap:10px;overflow:hidden;
  background:linear-gradient(120deg,#06b6d4,#4f8bff 50%,#7c5cff);box-shadow:0 18px 40px -12px rgba(34,211,238,.8)}
.fabbtn svg{width:20px;height:20px}
.fabbtn::before{content:"";position:absolute;inset:-2px;border-radius:22px;background:var(--grad-iris);z-index:-1;animation:spinhue 4s linear infinite;filter:blur(10px);opacity:.8}
body:not(.fab-on) .fab{display:none}

/* =========================================================
   BOTTOM SHEETS
   ========================================================= */
.mb{position:fixed;z-index:100;inset:0;display:none;align-items:flex-end;justify-content:center;padding:12px;background:rgba(10,10,35,.45);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.mb.open{display:flex}
.mp{width:min(100%,500px);max-height:92vh;overflow-y:auto;border-radius:30px;background:var(--glass-strong);border:1px solid var(--stroke);backdrop-filter:blur(30px);-webkit-backdrop-filter:blur(30px);box-shadow:0 40px 90px -20px rgba(0,0,0,.45);animation:sheet .45s cubic-bezier(.2,.9,.2,1)}
[data-theme="light"] .mp{background:rgba(255,255,255,.92)}
@keyframes sheet{from{opacity:0;transform:translateY(40px) scale(.97)}to{opacity:1;transform:none}}
.grab{width:42px;height:5px;border-radius:5px;margin:10px auto 0;background:var(--stroke)}
.mh{display:flex;align-items:center;justify-content:space-between;padding:10px 20px 4px}
.mt{margin:0;font-family:var(--display);font-size:17px;font-weight:700}
.mx{width:38px;height:38px;border:0;border-radius:12px;display:grid;place-items:center;font-size:20px;background:var(--stroke-soft)}
.mc{padding:14px 22px 24px}

.scanner{position:relative;width:96px;height:96px;margin:6px auto 16px;border-radius:26px;display:grid;place-items:center;color:#fff;background:var(--grad);box-shadow:0 18px 40px -12px rgba(124,92,255,.8);overflow:hidden}
.scanner svg{width:42px;height:42px}
.scanner::after{content:"";position:absolute;left:10%;right:10%;height:2px;top:15%;background:#fff;box-shadow:0 0 14px 3px #22d3ee;animation:scan 1.8s ease-in-out infinite}
@keyframes scan{0%,100%{top:15%}50%{top:82%}}
.ch{margin:0;text-align:center;font-family:var(--display);font-size:25px;font-weight:700;letter-spacing:-.03em}
.cc{margin:8px auto 0;max-width:340px;text-align:center;font-size:13px;line-height:1.55;color:var(--text-soft)}

.rprev{position:relative;margin-top:18px;padding:16px 18px;border-radius:22px;background:var(--stroke-soft);border:1px dashed var(--stroke)}
.rrow{display:flex;justify-content:space-between;gap:16px;margin-top:10px;font-size:12.5px;color:var(--text-soft)}
.rrow:first-child{margin-top:0}
.rrow strong{color:var(--text);text-align:right}
.cpts{margin-top:14px;padding:16px;border-radius:18px;text-align:center;color:#fff;background:var(--grad);box-shadow:0 14px 30px -12px rgba(79,139,255,.8)}
.cpts span{display:block;font-size:10.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;opacity:.85}
.cpts strong{display:block;margin-top:3px;font-family:var(--display);font-size:28px;font-weight:700}

.field{margin-top:16px}
.flabel{display:block;margin-bottom:8px;font-size:12px;font-weight:800}
.pfield{display:grid;grid-template-columns:76px 1fr;gap:8px}
.cc2,.inp{width:100%;min-height:56px;border-radius:16px;border:1px solid var(--stroke);background:var(--glass-strong);outline:none}
.cc2{display:grid;place-items:center;font-weight:800;font-size:14px}
.inp{padding:0 16px;font-size:16px;font-weight:600;letter-spacing:.04em;transition:border-color .2s,box-shadow .2s}
.inp:focus{border-color:var(--violet);box-shadow:0 0 0 4px rgba(124,92,255,.18),0 0 24px -6px rgba(34,211,238,.6)}
.ferr{min-height:17px;margin:6px 0 0;font-size:11.5px;font-weight:700;color:var(--bad)}
.note{margin:12px 0 0;text-align:center;font-size:10.5px;line-height:1.5;color:var(--muted)}

.sv{text-align:center;padding-top:4px}
.burst{position:relative;width:104px;height:104px;margin:0 auto;border-radius:50%;display:grid;place-items:center;color:#fff;font-size:42px;background:linear-gradient(135deg,#10b981,#22d3ee);animation:pop .6s cubic-bezier(.2,1.6,.4,1)}
.burst::before,.burst::after{content:"";position:absolute;inset:-10px;border-radius:50%;border:2px solid rgba(34,211,238,.5);animation:ripple 1.8s ease-out infinite}
.burst::after{animation-delay:.6s}
@keyframes pop{from{transform:scale(.3);opacity:0}to{transform:scale(1);opacity:1}}
@keyframes ripple{from{transform:scale(.9);opacity:1}to{transform:scale(1.6);opacity:0}}
.stitle{margin:22px 0 0;font-family:var(--display);font-size:28px;font-weight:700;letter-spacing:-.04em}
.ssub{margin:8px auto 0;max-width:320px;font-size:13px;line-height:1.55;color:var(--text-soft)}
.spts{margin:20px 0;padding:20px;border-radius:22px;background:var(--stroke-soft)}
.spts span{display:block;font-size:10.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.spts strong{display:block;margin-top:4px;font-family:var(--display);font-size:46px;font-weight:700;letter-spacing:-.04em}

.ill{width:90px;height:90px;margin:4px auto 14px;border-radius:28px;display:grid;place-items:center;font-size:44px}

/* =========================================================
   TOAST + CONFETTI + SPINNER
   ========================================================= */
.toasts{position:fixed;z-index:300;top:14px;left:50%;transform:translateX(-50%);width:min(calc(100% - 28px),460px);pointer-events:none}
.toast{display:flex;align-items:center;gap:11px;padding:13px 15px;border-radius:18px;font-size:13px;font-weight:600;background:var(--glass-strong);border:1px solid var(--stroke);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);box-shadow:var(--shadow);animation:tin .35s cubic-bezier(.2,.9,.2,1)}
@keyframes tin{from{opacity:0;transform:translateY(-14px) scale(.97)}to{opacity:1;transform:none}}
.tdot{width:26px;height:26px;flex:0 0 auto;border-radius:9px;display:grid;place-items:center;font-weight:900;color:#fff;background:linear-gradient(135deg,#10b981,#22d3ee)}
.toast.error .tdot{background:linear-gradient(135deg,#f43f5e,#ff8a5b)}
#confetti{position:fixed;inset:0;z-index:250;pointer-events:none}
.spin{width:19px;height:19px;border-radius:50%;border:3px solid rgba(255,255,255,.4);border-top-color:#fff;animation:sp .7s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}

@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
@media (min-width:760px){ .shell{padding-top:10px} }
@media (max-width:370px){ main{padding-left:14px;padding-right:14px} .rgrid{grid-template-columns:1fr} .stats{grid-template-columns:1fr} }
</style>
