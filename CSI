    hideVal();
    if (s !== 'admin') updateProgress();
    window.scrollTo({top: 0, behavior: 'smooth'});
  }

  // ── ADMIN EMAIL MANAGEMENT ──

  function renderAdminEmails() {
    const container = document.getElementById('fiEmailContainer');
    container.innerHTML = '';
    FI_LIST.forEach(fi => {
      const isOthers = fi === 'Others (Please Specify)';
      const data = adminData[fi];
      const block = document.createElement('div');
      block.className = 'fi-block';
      if (isOthers) block.style.cssText = 'border-color:var(--cgc-gold);background:var(--cgc-gold-light);';
      block.id = 'fi-block-' + safeName(fi);

      const header = document.createElement('div');
      header.className = 'fi-block-header';
      header.innerHTML = `<span class="fi-block-title">${isOthers ? '🏦 Others — Please Specify' : '🏦 ' + fi}</span>`;
      block.appendChild(header);

      if (isOthers) {
        const nameLabel = document.createElement('div');
        nameLabel.style.cssText = 'font-size:11px;font-weight:600;color:var(--cgc-gold-dark);margin-bottom:3px;';
        nameLabel.textContent = 'Institution Name (required)';
        block.appendChild(nameLabel);

        const nameWrapper = document.createElement('div');
        nameWrapper.style.cssText = 'display:flex;flex-direction:column;gap:3px;margin-bottom:10px;';
        const nameInput = document.createElement('input');
        nameInput.type = 'text';
        nameInput.className = 'fi-email-input';
        nameInput.placeholder = 'e.g. XYZ Finance Berhad';
        nameInput.value = data.customName || '';
        nameInput.style.fontWeight = '500';
        nameInput.addEventListener('input', () => { adminData[fi].customName = nameInput.value; });
        nameWrapper.appendChild(nameInput);
        block.appendChild(nameWrapper);

        const emailLabel = document.createElement('div');
        emailLabel.style.cssText = 'font-size:11px;font-weight:600;color:var(--cgc-gold-dark);margin-bottom:3px;';
        emailLabel.textContent = 'PIC Email Address(es)';
        block.appendChild(emailLabel);
      }

      const rowsDiv = document.createElement('div');
      rowsDiv.className = 'fi-email-rows';
      rowsDiv.id = 'fi-rows-' + safeName(fi);
      block.appendChild(rowsDiv);

      data.emails.forEach((email, idx) => {
        rowsDiv.appendChild(buildEmailRow(fi, idx, email));
      });

      container.appendChild(block);
    });
  }

  function buildEmailRow(fi, idx, value) {
    const wrapper = document.createElement('div');
    wrapper.style.cssText = 'display:flex;flex-direction:column;gap:3px;';

    const row = document.createElement('div');
    row.className = 'fi-email-row';

    const input = document.createElement('input');
    input.type = 'email';
    input.className = 'fi-email-input';
    input.placeholder = 'pic@bank.com or pic@bank.com.my';
    input.value = value || '';
    input.dataset.fi = fi;
    input.dataset.idx = idx;
    input.setAttribute('autocomplete', 'off');

    const errMsg = document.createElement('div');
    errMsg.className = 'fi-email-error';
    errMsg.id = 'err-' + safeName(fi) + '-' + idx;
    errMsg.textContent = 'Please enter a valid email (e.g. name@domain.com or name@domain.com.my)';

    input.addEventListener('input', () => {
      adminData[fi].emails[idx] = input.value;
      validateEmailInput(input, errMsg);
    });
    input.addEventListener('blur', () => {
      if (input.value.trim()) validateEmailInput(input, errMsg);
    });

    const addBtn = document.createElement('button');
    addBtn.className = 'btn-icon btn-add';
    addBtn.title = 'Add another email';
    addBtn.textContent = '+';
    addBtn.onclick = () => addEmailRow(fi);

    const removeBtn = document.createElement('button');
    removeBtn.className = 'btn-icon btn-remove';
    removeBtn.title = 'Remove this email';
    removeBtn.textContent = '−';
    removeBtn.style.display = adminData[fi].emails.length > 1 ? 'flex' : 'none';
    removeBtn.onclick = () => removeEmailRow(fi, idx);

    row.appendChild(input);
    row.appendChild(addBtn);
    row.appendChild(removeBtn);
    wrapper.appendChild(row);
    wrapper.appendChild(errMsg);
    return wrapper;
  }

  function validateEmailInput(input, errEl) {
    const val = input.value.trim();
    if (!val) {
      input.classList.remove('input-error', 'input-ok');
      errEl.classList.remove('show');
      return true;
    }
    const valid = isValidEmail(val);
    input.classList.toggle('input-error', !valid);
    input.classList.toggle('input-ok', valid);
    errEl.classList.toggle('show', !valid);
    return valid;
  }

  function isValidEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}(\.[a-zA-Z]{2})?$/.test(email.trim());
  }

  function addEmailRow(fi) {
    adminData[fi].emails.push('');
    renderAdminEmails();
    const rowsDiv = document.getElementById('fi-rows-' + safeName(fi));
    if (rowsDiv) {
      const inputs = rowsDiv.querySelectorAll('.fi-email-input');
      if (inputs.length) inputs[inputs.length - 1].focus();
    }
  }

  function removeEmailRow(fi, idx) {
    adminData[fi].emails.splice(idx, 1);
    if (adminData[fi].emails.length === 0) adminData[fi].emails.push('');
    renderAdminEmails();
  }

  function buildSharePointPayload() {
    // Returns array of records ready for SharePoint List via Power Automate
    // Suggested SharePoint List columns:
    //   FI_Name (Single line), Is_Others (Yes/No), Others_Name (Single line),
    //   PIC_Emails (Multiple lines / semicolon-separated), Updated_On (Date)
    return FI_LIST
      .map(fi => ({
        FI_Name: fi === 'Others (Please Specify)'
          ? (adminData[fi].customName.trim() || 'Others')
          : fi,
        Is_Others: fi === 'Others (Please Specify)',
        Others_Name: fi === 'Others (Please Specify)' ? (adminData[fi].customName.trim() || '') : '',
        PIC_Emails: adminData[fi].emails.filter(e => e.trim()).join(';'),
        Updated_On: new Date().toISOString()
      }))
      .filter(row => row.PIC_Emails.length > 0);
  }

  function saveAdminSettings() {
    let hasError = false;
    FI_LIST.forEach(fi => {
      adminData[fi].emails.forEach(email => {
        if (email.trim() && !isValidEmail(email.trim())) hasError = true;
      });
    });

    if (hasError) {
      document.querySelectorAll('.fi-email-input[data-fi]').forEach(input => {
        const fi = input.dataset.fi;
        const idx = parseInt(input.dataset.idx);
        const errEl = document.getElementById('err-' + safeName(fi) + '-' + idx);
        if (errEl && input.value.trim()) validateEmailInput(input, errEl);
      });
      showVal('Please fix invalid email addresses before saving.');
      return;
    }

    // ── SharePoint / Power Automate Integration ───────────────────────────
    // When ready, replace the comment block below with your Power Automate
    // HTTP trigger POST. The payload is already structured for SharePoint.
    //
    // const payload = buildSharePointPayload();
    // fetch('YOUR_POWER_AUTOMATE_HTTP_TRIGGER_URL', {
    //   method: 'POST',
    //   headers: { 'Content-Type': 'application/json' },
    //   body: JSON.stringify({ records: payload })
    // })
    // .then(r => r.ok ? showSaveSuccess() : showVal('Save failed. Please try again.'))
    // .catch(() => showVal('Network error. Please try again.'));
    //
    // Payload preview (console):
    console.log('[Survey Admin] SharePoint payload preview:', buildSharePointPayload());
    // ─────────────────────────────────────────────────────────────────────

    showSaveSuccess();
  }

  function showSaveSuccess() {
    const msg = document.getElementById('adminSuccessMsg');
    msg.classList.add('show');
    setTimeout(() => msg.classList.remove('show'), 3500);
  }

  function safeName(str) {
    return str.replace(/[^a-zA-Z0-9]/g, '_');
  }

  function updateProgress() {
    const m = {a:12, b:50, c:82};
    document.getElementById('progressFill').style.width = (m[cur]||12) + '%';
  }

  function showVal(msg) {
    const b = document.getElementById('valBanner');
    b.textContent = '⚠️ ' + msg;
    b.classList.add('show');
  }

  function hideVal() {
    document.getElementById('valBanner').classList.remove('show');
  }

  function goToB() {
    const name = document.getElementById('q1').value.trim();
    const fi = document.querySelectorAll('input[name="fi"]:checked').length;
    const dept = document.querySelectorAll('input[name="dept"]:checked').length;
    if (!name) { showVal('Please enter your name.'); return; }
    if (!fi)   { showVal('Please select at least one Financial Institution.'); return; }
    if (!dept) { showVal('Please select at least one CGC Department.'); return; }
    markDone('a');
    navTo('b');
  }

  function goToC() {
    const required = ['q4','q5','q6','q7','q8'];
    const missing = required.filter(q => !document.querySelector(`input[name="${q}"]:checked`));
    if (missing.length) {
      showVal('Please rate all Service Delivery attributes (Q4–Q8) before continuing.');
      return;
    }
    buildSummary();
    markDone('b');
    navTo('c');
  }

  function submitForm() {
    const comment = document.getElementById('q13').value.trim();
    if (!comment) { showVal('Please share at least one suggestion or comment.'); return; }
    // Hide all
    sections.forEach(id => document.getElementById('sec-'+id).classList.remove('active'));
    markDone('c');
    document.getElementById('sec-success').classList.add('show');
    document.getElementById('progressFill').style.width = '100%';
    sections.forEach(id => {
      const n = document.getElementById('nav-'+id);
      if (n) n.classList.remove('active');
    });
    window.scrollTo({top:0, behavior:'smooth'});
  }

  function markDone(s) {
    const dot = document.getElementById('dot-'+s);
    if (dot) { dot.classList.remove('active'); dot.classList.add('done'); }
    const nav = document.getElementById('nav-'+s);
    if (nav) { nav.classList.remove('active'); nav.classList.add('done'); }
    const nc = document.getElementById('nc-'+s);
    if (nc) nc.textContent = '✓';
  }

  function buildSummary() {
    const name = document.getElementById('q1').value.trim();
    const fi = [...document.querySelectorAll('input[name="fi"]:checked')].map(x=>x.value).join(', ');
    const dept = [...document.querySelectorAll('input[name="dept"]:checked')].map(x=>x.value).join(', ');

    const qs = {
      q4:'Courtesy &amp; Friendliness', q5:'Professionalism', q6:'Knowledge &amp; Expertise',
      q7:'Ease of Contact', q8:'Response Time',
      q9:'Portal Navigation', q10:'Submission Success Rate', q11:'Portal Support', q12:'Portal Overall'
    };

    let html = `<strong>Name:</strong> ${name}<br><strong>Institution:</strong> ${fi}<br><strong>Department:</strong> ${dept}<br><br><strong>Ratings:</strong><br>`;

    for (const [q, label] of Object.entries(qs)) {
      const r = document.querySelector(`input[name="${q}"]:checked`);
      if (r) {
        const v = +r.value;
        const stars = '<span style="color:var(--cgc-gold)">★</span>'.repeat(v) + '<span style="color:#D1D9E6">★</span>'.repeat(5-v);
        html += `${label}: ${stars} <strong style="color:var(--cgc-navy)">(${v}/5)</strong><br>`;
      }
    }

    document.getElementById('summaryContent').innerHTML = html;
  }

  function resetForm() {
    document.getElementById('sec-success').classList.remove('show');
    document.getElementById('q1').value = '';
    document.getElementById('q13').value = '';
    document.getElementById('fi-others').value = '';
    document.querySelectorAll('input[type="radio"]').forEach(r => r.checked = false);
    document.querySelectorAll('input[type="checkbox"]').forEach(c => c.checked = false);
    document.querySelectorAll('.check-item').forEach(i => i.classList.remove('checked'));
    sections.forEach(id => {
      const dot = document.getElementById('dot-'+id);
      if (dot) dot.classList.remove('done','active');
      const nav = document.getElementById('nav-'+id);
      if (nav) nav.classList.remove('done','active');
      const nc = document.getElementById('nc-'+id);
      if (nc) nc.textContent = {a:'3',b:'9',c:'1'}[id];
    });
    navTo('a');
  }

  // Checkbox styling on change
  document.addEventListener('change', e => {
    if (e.target.type === 'checkbox') {
      const item = e.target.closest('.check-item');
      if (item) item.classList.toggle('checked', e.target.checked);
    }
  });

  updateProgress();
</script>
</body>
